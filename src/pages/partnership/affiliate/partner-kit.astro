---
export const prerender = true;
import SocialLinks from "../../../components/SocialLinks.astro";
// src/pages/partnership/affiliate/partner-kit.astro — Styles: /style/index-style.css + /style/affiliate-style.css
const site = "https://emmystack01.com";
const url = `${site}/partnership/affiliate/partner-kit`;
const title = 'Partner Toolkit | Emmy STACK01 Digital DNA';
const desc = 'Access official Emmy STACK01 marketing assets. Download high-performance visuals and copy to promote Digital DNA profiles and vCard websites.';
const ogTitle = 'Emmy STACK01 Partner Toolkit';
const ogDesc = 'Official promotional assets and swipe copy for Emmy STACK01 affiliate partners.';
const ogImage = `${site}/asset/og-image3.png`;
const tools = [
  { n: "Website Auditor", s: "website-auditor", i: "ri-shield-check-line" },
  { n: "Social Architect", s: "social-architect", i: "ri-node-tree" },
  { n: "Meeting Studio", s: "meeting_background_studio", i: "ri-vidicon-line" },
  { n: "PDF Signer", s: "emmy-sign", i: "ri-file-pdf-2-line" },
  { n: "Invoice Generator", s: "naira-wise", i: "ri-bill-line" },
];
const org = { "@type": "Organization", "@id": `${site}/#organization`, name: "Emmy STACK01", url: `${site}/`, logo: `${site}/asset/emmy-stack01-logo.png`, image: ogImage, sameAs: ["https://x.com/Emmy_STACK01", "https://wa.me/2349076991076"] };
const media = [
  { kind: "image", title: "Digital DNA solution", src: "/asset/Emmy%20STACK01_The_solution.png", file: "Emmy_STACK01_Solution.png", alt: "Digital DNA solution graphic", btn: "Download image",
    caption: "First impressions are everything in 2026. Get a professional Digital DNA profile + SEO for 5% off using my link. 🚀 #EmmySTACK01 #DigitalIdentity" },
  { kind: "video", title: "Fastest way to exchange info", src: "/asset/The%20fastest%20way%20to%20exchange%20info.mp4", file: "Emmy_Exchange_Demo.mp4", btn: "Download video",
    caption: "Stop carrying paper cards. Claim your digital territory with Emmy STACK01. Get a full portfolio site, SEO, and contact integration for just $60. Use code [Partner Code] for 5% off!" },
  { kind: "image", title: "Business card package", src: "/asset/Emmy%20STACK01_Business_Card_Package.png", file: "Emmy_STACK01_Business_Card_Package.png", alt: "Emmy STACK01 digital business card package", btn: "Download image" },
  { kind: "image", title: "Check out our demos", src: "/asset/Checkout-our-Demos.png", file: "Emmy_Demos.png", alt: "Emmy STACK01 demo websites", btn: "Download image" },
  { kind: "image", style: "logo", title: "Logo", src: "/asset/emmy-stack01-logo.png", file: "EmmySTACK01_Logo.png", alt: "Emmy STACK01 logo", btn: "Download logo" },
  { kind: "image", style: "icon", title: "Favicon", src: "/favicon_io/android-chrome-192x192.png", file: "EmmySTACK01_Favicon.png", alt: "Emmy STACK01 favicon", btn: "Download favicon" },
];
const swipes = [
  { icon: "ri-whatsapp-line", title: "WhatsApp status swipe", text: "If your business isn't on Google yet, you're invisible. 🕵️‍♂️ I'm partnering with Emmy STACK01 to get you a professional website + SEO + Digital Card for a steal. Use my link for a 5% discount! [Insert ShortLink]" },
  { icon: "ri-twitter-x-line", title: "X (Twitter) swipe", text: "Stop building on rented land. Own your identity. 🌐 Just partnered with @EmmySTACK01 to bring 'Digital DNA' profiles to my network. DM for the 5% off code. #Web3 #PersonalBranding" },
];
const abs = (p) => (p.startsWith("http") ? p : `${site}${p}`);
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebPage", "@id": `${url}#webpage`, url, name: title, description: desc, isPartOf: { "@type": "WebSite", "@id": `${site}/#website`, url: `${site}/`, name: "Emmy STACK01" }, inLanguage: "en-US",
      mainEntity: { "@type": "ItemList", name: "Emmy STACK01 affiliate marketing assets", description: "Promotional images, motion video and social swipe copy for registered partners.",
        itemListElement: media.map((m, i) => ({ "@type": "ListItem", position: i + 1, item: m.kind === "video"
          ? { "@type": "VideoObject", name: m.title, contentUrl: abs(m.src), description: m.caption, thumbnailUrl: ogImage, uploadDate: "2026-01-01T00:00:00Z" }
          : { "@type": "ImageObject", name: m.title, contentUrl: abs(m.src), description: m.alt } })) } },
    org,
  ],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="/script/meta-logic.js" is:inline></script>
    <meta name="robots" content="noindex, nofollow">
    <meta name="author" content="Emmy STACK01">
    <meta name="theme-color" content="#0b1020">

    <link rel="stylesheet" href="/style/index-style.css">
    <link rel="stylesheet" href="/style/affiliate-style.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Manrope:wght@400..800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.7.0/fonts/remixicon.css" rel="stylesheet">

    <link rel="apple-touch-icon" sizes="180x180" href={`${site}/favicon_io/apple-touch-icon.png`}>
    <link rel="icon" type="image/png" sizes="32x32" href={`${site}/favicon_io/favicon-32x32.png`}>
    <link rel="icon" type="image/png" sizes="16x16" href={`${site}/favicon_io/favicon-16x16.png`}>
    <link rel="manifest" href={`${site}/favicon_io/site.webmanifest`}>
    <title>{title}</title>
    <meta name="description" content={desc}>
    <link rel="canonical" href={url}>

    <meta property="og:site_name" content="Emmy STACK01">
    <meta property="og:type" content="website">
    <meta property="og:title" content={ogTitle}>
    <meta property="og:description" content={ogDesc}>
    <meta property="og:url" content={url}>
    <meta property="og:image" content={ogImage}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@Emmy_STACK01">
    <meta name="twitter:title" content={ogTitle}>
    <meta name="twitter:description" content={ogDesc}>
    <meta name="twitter:image" content={ogImage}>

    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
</head>
<body>
    <!-- Desktop nav -->
    <nav class="nav" aria-label="Main">
        <a class="logo" href="/">Emmy STACK01</a>
        <ul class="nav-links">
            <li><a href="/">Home</a></li>
            <li><a href="/websites">Websites</a></li>
            <li><a href="/products">Product</a></li>
            <li class="dropdown js-dropdown">
                <button type="button" class="dropbtn" aria-expanded="false">Tools <i class="ri-arrow-down-s-line"></i></button>
                <div class="dropdown-content">
                    {tools.map((t) => <a href={`/tools/${t.s}`}><i class={t.i}></i> {t.n}</a>)}
                </div>
            </li>
            <li><a href="/partnership" aria-current="page">Partnership Program <span class="earn-pill">EARN</span></a></li>
            <li><a href="/articles">Articles</a></li>
        </ul>
        <a href="/partnership/policy" class="cta nav-cta">Partner Policy <i class="ri-arrow-right-line"></i></a>
    </nav>

    <!-- Mobile bar -->
    <div class="navbar">
        <a class="logo" href="/">Emmy STACK01</a>
        <button class="nav-toggle" id="openMenu" aria-label="Open navigation" aria-controls="drawer" aria-expanded="false">
            <span class="line"></span><span class="line"></span><span class="line"></span>
        </button>
    </div>

    <div class="overlay" id="overlay"></div>
    <aside class="drawer" id="drawer" aria-label="Site navigation" aria-hidden="true">
        <div class="drawer-header">
            <a class="logo" href="/">Emmy STACK01</a>
            <button id="closeMenu" class="close-btn" aria-label="Close navigation"><i class="ri-close-line"></i></button>
        </div>
        <nav class="drawer-nav">
            <a href="/" class="drawer-link"><i class="ri-home-line"></i> Home</a>
            <a href="/websites" class="drawer-link"><i class="ri-layout-4-line"></i> Websites</a>
            <a href="/products" class="drawer-link"><i class="ri-box-3-line"></i> Product</a>
            <button class="drawer-link dropdown-btn" id="toolsBtn" aria-expanded="false" aria-controls="toolsMenu">
                <i class="ri-tools-line"></i> Tools <i class="ri-arrow-down-s-line chev"></i>
            </button>
            <div class="submenu" id="toolsMenu"><div class="submenu-inner">
                {tools.map((t) => <a href={`/tools/${t.s}`}><i class={t.i}></i> {t.n}</a>)}
            </div></div>
            <a href="/partnership" class="drawer-link active" aria-current="page"><i class="ri-team-line"></i> Partnership Program <span class="earn-pill">EARN</span></a>
            <a href="/articles" class="drawer-link"><i class="ri-article-line"></i> Articles</a>
        </nav>
        <a href="/partnership/policy" class="cta project-btn">Partner Policy <i class="ri-arrow-right-line"></i></a>
        <div class="drawer-foot">
            <SocialLinks />
            <p>&copy; <span class="year"></span> Emmy STACK01. All rights reserved.</p>
        </div>
    </aside>

    <header class="af-hero">
        <div class="af-hero-inner">
            <a class="af-back" href="/partnership/affiliate"><i class="ri-arrow-left-line" aria-hidden="true"></i> Affiliate dashboard</a>
            <span class="af-eyebrow">Partner toolkit</span>
            <h1>Promotional <em>assets</em></h1>
            <p>Download graphics and video, or copy ready-made captions. Your code and link are filled in for you.</p>
        </div>
    </header>

    <main>
        <section class="af-wrap" aria-label="Promotional assets">
            <p class="kt-note" id="ktNote">
                <i class="ri-user-star-line" aria-hidden="true"></i>
                <span id="ktNoteText">Log in on the <a href="/partnership/affiliate">affiliate page</a> to fill in your own code and link automatically.</span>
            </p>

            <div class="kt-grid">
                {media.map((m) => (
                    <article class="kt-card">
                        <div class={`kt-media ${m.style || ""}`}>
                            {m.kind === "video"
                                ? <video src={m.src} muted loop playsinline autoplay preload="metadata" controls aria-label={m.title}></video>
                                : <img src={m.src} alt={m.alt} loading="lazy" decoding="async">}
                        </div>
                        <h3>{m.title}</h3>
                        <a class="cta kt-dl" href={m.src} download={m.file}><i class="ri-download-2-line" aria-hidden="true"></i> {m.btn}</a>
                        {m.caption && (
                            <div class="kt-copybox">
                                <p class="kt-text" data-template={m.caption}>{m.caption}</p>
                                <button type="button" class="kt-copybtn" aria-label={`Copy caption for ${m.title}`}><i class="ri-file-copy-line" aria-hidden="true"></i></button>
                            </div>
                        )}
                    </article>
                ))}

                {swipes.map((s) => (
                    <article class="kt-card">
                        <span class="kt-icon"><i class={s.icon} aria-hidden="true"></i></span>
                        <h3>{s.title}</h3>
                        <div class="kt-copybox">
                            <p class="kt-text" data-template={s.text}>{s.text}</p>
                            <button type="button" class="kt-copybtn" aria-label={`Copy ${s.title}`}><i class="ri-file-copy-line" aria-hidden="true"></i></button>
                        </div>
                    </article>
                ))}
            </div>
            <p class="kt-live" id="ktLive" role="status" aria-live="polite"></p>
        </section>
    </main>

    <footer class="footer">
        <div class="footer-container">
            <div class="footer-column"><h3><i class="ri-share-forward-box-line"></i> Ecosystem Hub</h3><ul>
                <li><a href="/">Home</a></li><li><a href="/websites">Websites</a></li><li><a href="/products">Products</a></li><li><a href="/pricing">Pricing</a></li><li><a href="/articles">Articles</a></li></ul></div>
            <div class="footer-column"><h3><i class="ri-rocket-2-line"></i> Flagship Product</h3><ul>
                <li><a href="/products/digital-business-card">Digital Business Card</a></li>
                <li><a href="/products/digital-business-card#demo">Live Demos</a></li>
                <li><a href="/products/digital-business-card#launch-package">Build Your Card</a></li>
                <li><a href="/payment" rel="nofollow">Payment <i class="ri-verified-badge-fill"></i></a></li></ul></div>
            <div class="footer-column"><h3><i class="ri-tools-line"></i> Technical Tools</h3><ul>
                {tools.map((t) => <li><a href={`/tools/${t.s}`}>{t.n}</a></li>)}</ul></div>
            <div class="footer-column"><h3><i class="ri-team-line"></i> Partnership</h3><ul>
                <li><a href="/partnership">Partnership Program</a></li><li><a href="/partnership/affiliate">Affiliate Portal</a></li><li><a href="/partnership/policy">Partner Policy</a></li></ul></div>
        </div>
        <div class="footer-bottom">
            <div class="footer-legal">
                <SocialLinks />
                <p>&copy; <span class="year"></span> Emmy STACK01. All Rights Reserved.</p>
            </div>
        </div>
    </footer>

<script is:inline>
document.addEventListener("DOMContentLoaded", () => {
  const $ = (s, r = document) => r.querySelector(s), $$ = (s, r = document) => [...r.querySelectorAll(s)];
  const drawer = $("#drawer"), overlay = $("#overlay"), openBtn = $("#openMenu");
  const setDrawer = (open) => {
    drawer.classList.toggle("open", open); overlay.classList.toggle("open", open);
    drawer.setAttribute("aria-hidden", String(!open)); openBtn.setAttribute("aria-expanded", String(open));
    document.body.classList.toggle("no-scroll", open);
    if (open) $("#closeMenu").focus(); else openBtn.focus({ preventScroll: true });
  };
  openBtn.addEventListener("click", () => setDrawer(true));
  $("#closeMenu").addEventListener("click", () => setDrawer(false));
  overlay.addEventListener("click", () => setDrawer(false));
  $$("#drawer a").forEach((a) => a.addEventListener("click", () => setDrawer(false)));
  const toolsBtn = $("#toolsBtn");
  toolsBtn.addEventListener("click", () => {
    const o = $("#toolsMenu").classList.toggle("open");
    toolsBtn.classList.toggle("open", o); toolsBtn.setAttribute("aria-expanded", String(o));
  });
  const dd = $(".js-dropdown"), ddBtn = $(".dropbtn", dd);
  ddBtn.addEventListener("click", (e) => { e.stopPropagation(); ddBtn.setAttribute("aria-expanded", String(dd.classList.toggle("open"))); });
  document.addEventListener("click", () => { dd.classList.remove("open"); ddBtn.setAttribute("aria-expanded", "false"); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && drawer.classList.contains("open")) setDrawer(false); });
});
</script>
<script is:inline>
(() => {
  // Personalise captions with the partner's own code and link (fetched with the signed-in session cookie)
  const personalise = (code) => {
    const link = `https://emmystack01.com/go/?id=${code}`;
    document.querySelectorAll(".kt-text").forEach((p) => {
      p.textContent = p.dataset.template.split("[Partner Code]").join(code).split("[Insert ShortLink]").join(link);
    });
    document.getElementById("ktNoteText").innerHTML = "Captions are filled in with your code <strong></strong> and your referral link.";
    document.querySelector("#ktNoteText strong").textContent = code;
  };
  fetch("/api/partner/me", { credentials: "same-origin" })
    .then((r) => (r.ok ? r.json() : null))
    .then((d) => { if (d && d.partner && d.partner.code) personalise(d.partner.code); })
    .catch(() => {});

  // Copy buttons
  const live = document.getElementById("ktLive");
  document.querySelectorAll(".kt-copybtn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.parentElement.querySelector(".kt-text").textContent;
      const icon = btn.querySelector("i");
      try {
        await navigator.clipboard.writeText(text);
        icon.className = "ri-check-line"; btn.classList.add("done"); live.textContent = "Copied to clipboard.";
      } catch (e) {
        live.textContent = "Copy failed. Select the text and copy it manually.";
      }
      setTimeout(() => { icon.className = "ri-file-copy-line"; btn.classList.remove("done"); live.textContent = ""; }, 2000);
    });
  });

  // Respect reduced motion: don't autoplay the demo video
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll("video").forEach((v) => { v.removeAttribute("autoplay"); v.pause(); });
  }
})();
</script>
<script src="/script/year.js" defer></script>
</body>
</html>
