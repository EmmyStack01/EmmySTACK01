<script is:inline>
document.addEventListener("DOMContentLoaded", () => {
  const $ = (s, r = document) => r.querySelector(s), $$ = (s, r = document) => [...r.querySelectorAll(s)];
  const drawer = $("#drawer"), overlay = $("#overlay"), openBtn = $("#openMenu");
  const setDrawer = (open) => {
    drawer.classList.toggle("open", open); overlay.classList.toggle("open", open);
    drawer.setAttribute("aria-hidden", String(!open)); openBtn.setAttribute("aria-expanded", String(open));
    document.body.classList.toggle("no-scroll", open);
    if (open) $("#closeMenu").focus(); else openBtn.focus({ preventScroll: true });
  };
  openBtn.addEventListener("click", () => setDrawer(true));
  $("#closeMenu").addEventListener("click", () => setDrawer(false));
  overlay.addEventListener("click", () => setDrawer(false));
  $$("#drawer a").forEach((a) => a.addEventListener("click", () => setDrawer(false)));
  const toolsBtn = $("#toolsBtn");
  toolsBtn.addEventListener("click", () => {
    const o = $("#toolsMenu").classList.toggle("open");
    toolsBtn.classList.toggle("open", o); toolsBtn.setAttribute("aria-expanded", String(o));
  });
  const dd = $(".js-dropdown"), ddBtn = $(".dropbtn", dd);
  ddBtn.addEventListener("click", (e) => { e.stopPropagation(); ddBtn.setAttribute("aria-expanded", String(dd.classList.toggle("open"))); });
  document.addEventListener("click", () => { dd.classList.remove("open"); ddBtn.setAttribute("aria-expanded", "false"); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && drawer.classList.contains("open")) setDrawer(false); });
});
</script>
<script is:inline>
(() => {
  const AFFILIATE_PAGE = "/partnership/affiliate";
  let partnerLink = null;
  const live = document.getElementById("ktLive");

  const say = (msg) => { live.textContent = msg; setTimeout(() => { live.textContent = ""; }, 3500); };
  const flash = (btn, ok) => {
    const icon = btn.querySelector("i"), prev = icon.className;
    if (ok) { icon.className = "ri-check-line"; btn.classList.add("done"); }
    setTimeout(() => { icon.className = prev; btn.classList.remove("done"); }, 2000);
  };
  const copy = async (text, btn, okMsg) => {
    try { await navigator.clipboard.writeText(text); flash(btn, true); say(okMsg); }
    catch (e) { say("Copy failed. Select the text and copy it manually."); }
  };

  // Personalise captions with the partner's own code and link (fetched with the signed-in session cookie)
  const personalise = (code) => {
    const link = `https://emmystack01.com/go/?id=${code}`;
    partnerLink = link;
    document.querySelectorAll(".kt-text").forEach((p) => {
      p.textContent = p.dataset.template.split("[Partner Code]").join(code).split("[Insert ShortLink]").join(link);
    });
    document.getElementById("ktNoteText").innerHTML = "Captions are filled in with your code <strong></strong> and your referral link.";
    document.querySelector("#ktNoteText strong").textContent = code;
    document.querySelectorAll(".kt-linkbtn span").forEach((s) => { s.textContent = "Copy my affiliate link"; });
  };
  fetch("/api/partner/me", { credentials: "same-origin" })
    .then((r) => (r.ok ? r.json() : null))
    .then((d) => { if (d && d.partner && d.partner.code) personalise(d.partner.code); })
    .catch(() => {});

  // Get / copy affiliate link (sends logged-out visitors to the affiliate page)
  document.querySelectorAll(".kt-linkbtn").forEach((btn) => {
    btn.addEventListener("click", () => {
      if (!partnerLink) { window.location.href = AFFILIATE_PAGE; return; }
      copy(partnerLink, btn, "Affiliate link copied.");
    });
  });

  // Copy caption buttons
  document.querySelectorAll(".kt-copybtn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const text = btn.parentElement.querySelector(".kt-text").textContent;
      const needsFill = text.includes("[Insert ShortLink]") || text.includes("[Partner Code]");
      copy(text, btn, needsFill ? "Copied. Replace [Insert ShortLink] with your link, or log in to fill it in automatically." : "Copied to clipboard.");
    });
  });

  // Respect reduced motion
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll("video").forEach((v) => { v.removeAttribute("autoplay"); v.pause(); });
  }
})();
</script>
<script src="/script/year.js" defer></script>
</body>
</html>
