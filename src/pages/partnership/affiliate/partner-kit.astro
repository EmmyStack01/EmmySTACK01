---
export const prerender = true;
import SocialLinks from "../../../components/SocialLinks.astro";
// src/pages/partnership/affiliate/partner-kit.astro — Styles: /style/index-style.css + /style/affiliate-style.css
const site = "https://emmystack01.com";
const url = `${site}/partnership/affiliate/partner-kit`;
const title = 'Partner Kit | Emmy STACK01 Affiliate Program';
const desc = 'Official Emmy STACK01 partner kit. Choose a kit for websites, digital business cards or creator websites, then download assets and copy ready-made captions.';
const ogTitle = 'Emmy STACK01 Partner Toolkit';
const ogDesc = 'Official promotional assets and swipe copy for Emmy STACK01 affiliate partners.';
const ogImage = `${site}/asset/og-partner-kit.png`;
const tools = [
  { n: "Website Auditor", s: "website-auditor", i: "ri-shield-check-line" },
  { n: "Social Architect", s: "social-architect", i: "ri-node-tree" },
  { n: "Meeting Studio", s: "meeting_background_studio", i: "ri-vidicon-line" },
  { n: "PDF Signer", s: "emmy-sign", i: "ri-file-pdf-2-line" },
  { n: "Invoice Generator", s: "naira-wise", i: "ri-bill-line" },
];
const org = { "@type": "Organization", "@id": `${site}/#organization`, name: "Emmy STACK01", url: `${site}/`, logo: `${site}/asset/emmy-stack01-logo.svg`, image: ogImage, sameAs: ["https://x.com/Emmy_STACK01", "https://wa.me/2349076991076"] };

// Each kit = one audience + one purpose. "assets" are downloadable files, "copy" are captions.
// [Insert ShortLink] is the partner's affiliate link: it opens a WhatsApp chat with Emmy STACK01 (prefilled message) and gives 5% off.
// It is filled in automatically for logged-in partners (see script at the bottom).
const LINK = "[Insert ShortLink]";
const kits = [
  {
    id: "websites", title: "Website Solutions", promo: true,
    audience: "Business owners, founders, consultants, service providers and professionals.",
    purpose: "Generate referrals for website design and development.",
    page: { href: "/websites", label: "View the Websites page" },
    assets: [
      // TODO: add a website solutions graphic when available
    ],
    copy: [
      { icon: "ri-whatsapp-line", title: "WhatsApp status caption", text: `A lot of businesses rely on social media to show what they do. But where can people go to see your work, learn about your services and contact you? A professional website brings it all together.\n\nI'm partnering with Emmy STACK01, who build websites for businesses, professionals and creators. Tap my link to chat with them on WhatsApp and get 5% off: ${LINK}` },
      { icon: "ri-twitter-x-line", title: "X post", text: `Your social profile introduces your business. A website lets people explore your services, see your work and get in touch. I'm a partner of @Emmy_STACK01. Chat with them on WhatsApp for 5% off: ${LINK}` },
      { icon: "ri-chat-quote-line", title: "Longer personal recommendation", text: `A lot of businesses rely on social media to show people what they do. But what happens when someone wants to learn more about your services, see your work, or find the right way to contact you?\n\nA professional website gives your business a place to bring all of that together.\n\nI'm partnering with Emmy STACK01, which builds websites for businesses, professionals, and creators.\n\nMessage them on WhatsApp through my link and get 5% off: ${LINK}` },
    ],
  },
  {
    id: "digital-business-card", title: "Digital Business Card", promo: true,
    audience: "Entrepreneurs, consultants, freelancers, creators and professionals who regularly meet new people.",
    purpose: "Promote the flagship Digital Business Card product.",
    page: { href: "/products/digital-business-card", label: "View the Digital Business Card page" },
    assets: [
      { kind: "image", title: "Digital Business Card graphic", src: "/asset/product-card-design-1920x1080.png", file: "product-card-design-1920x1080.png", alt: "Emmy STACK01 digital business card graphic", btn: "Download image" },
      // TODO: add a short demo video when available
    ],
    copy: [
      { icon: "ri-whatsapp-line", title: "WhatsApp status caption", text: `How many times have you met someone, exchanged contacts, and then struggled to find their details later?\n\nA digital business card gives people one simple place to find your contact information, social links, work, and services.\n\nEmmy STACK01 builds professional digital business card websites that are easy to share.\n\nMessage them on WhatsApp through my link and get 5% off: ${LINK}` },
      { icon: "ri-twitter-x-line", title: "X post", text: `Met someone, swapped contacts, then couldn't find their details later? A digital business card puts your contact info, links, work and services in one place. I'm a partner of @Emmy_STACK01. Get 5% off via WhatsApp: ${LINK}` },
      { icon: "ri-list-check-2", title: "Feature highlights", text: `One link for your contact information, social links, work and services.\nEasy to share with anyone you meet.\nBuilt as a professional website by Emmy STACK01.\n\nMessage them on WhatsApp for 5% off: ${LINK}` },
    ],
  },
  {
    id: "creators", title: "Creator & Personal Brand Websites", promo: true,
    audience: "Writers, photographers, musicians, influencers and other creators.",
    purpose: "Attract people who need a portfolio or a central place to showcase their work.",
    page: { href: "/websites", label: "View website solutions" },
    assets: [
      // TODO: add creator website graphic, portfolio screenshots and a blog website example when available
    ],
    copy: [
      { icon: "ri-whatsapp-line", title: "WhatsApp status caption", text: `If you're a creator, your social media profile can introduce you to people. But where can they go to explore your work, understand what you offer, and find out how to work with you?\n\nA personal website or portfolio gives you more room to tell your story and showcase what you do.\n\nEmmy STACK01 builds websites for creators and professionals who want a stronger online presence.\n\nMessage them on WhatsApp through my link and get 5% off: ${LINK}` },
      { icon: "ri-twitter-x-line", title: "X post", text: `Social media introduces you. A portfolio website shows your work, explains what you offer and tells people how to hire you. I'm a partner of @Emmy_STACK01. Chat with them on WhatsApp for 5% off: ${LINK}` },
    ],
  },
  {
    id: "demos", title: "Website Demos & Projects", promo: true,
    audience: "People who want to see examples before considering a service.",
    purpose: "Build confidence by showing real work.",
    page: { href: "/websites", label: "View the Websites page" },
    assets: [
      // TODO: add real website screenshots, mobile screenshots, project descriptions and live project links.
      // Only list projects that are live and viewable.
    ],
    copy: [
      { icon: "ri-share-forward-line", title: "Caption partners can personalise", text: `Before choosing someone to build your website, it's worth seeing the kind of work they do.\n\nHere are a few projects built by Emmy STACK01, from a Web3 creator's website to a nursery and primary school website. See them here: ${site}/websites\n\nWhen you're ready, message Emmy STACK01 on WhatsApp through my link and get 5% off: ${LINK}` },
    ],
  },
  {
    id: "brand", title: "General Brand Assets", promo: false,
    audience: "Any partner, whichever service they promote.",
    purpose: "The logo and basic brand information for use alongside any kit.",
    page: { href: "/", label: "Official website" },
    assets: [
      { kind: "image", style: "logo", title: "Logo", src: "/favicon_io/android-chrome-512x512.png", file: "EmmySTACK01_Logo.png", alt: "Emmy STACK01 logo", btn: "Download logo" },
      // TODO: add transparent logo, optional profile/promo graphics, and brand colours + usage guidelines
    ],
    copy: [
      { icon: "ri-information-line", title: "Short brand description", text: "Emmy STACK01 is a Nigerian digital agency that builds websites for businesses, professionals and creators, including a flagship Digital Business Card product." },
      { icon: "ri-global-line", title: "Official website", text: "Emmy STACK01: https://emmystack01.com" },
    ],
  },
];
const allAssets = kits.flatMap((k) => k.assets);

const abs = (p) => (p.startsWith("http") ? p : `${site}${p}`);
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebPage", "@id": `${url}#webpage`, url, name: title, description: desc, isPartOf: { "@type": "WebSite", "@id": `${site}/#website`, url: `${site}/`, name: "Emmy STACK01" }, inLanguage: "en-US",
      mainEntity: { "@type": "ItemList", name: "Emmy STACK01 affiliate marketing assets", description: "Promotional images, video and social captions for registered partners.",
        itemListElement: allAssets.map((m, i) => ({ "@type": "ListItem", position: i + 1, item: m.kind === "video"
          ? { "@type": "VideoObject", name: m.title, contentUrl: abs(m.src), description: m.desc || m.title, thumbnailUrl: ogImage, uploadDate: "2026-01-01T00:00:00Z" }
          : { "@type": "ImageObject", name: m.title, contentUrl: abs(m.src), description: m.alt } })) } },
    org,
  ],
};
