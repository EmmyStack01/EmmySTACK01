                    </div>
                </div>

                <div class="af-dash-grid">
                    <div class="af-stack">
                        <dl class="af-stats">
                            <div class="af-stat">
                                <dt>Clicks <button type="button" class="af-tip" aria-label="What are clicks?"><i class="ri-information-line" aria-hidden="true"></i><span class="tipbox" role="tooltip">Number of times your link was clicked.</span></button></dt>
                                <dd id="dashClicks">0</dd>
                            </div>
                            <div class="af-stat">
                                <dt>Leads <button type="button" class="af-tip" aria-label="What are leads?"><i class="ri-information-line" aria-hidden="true"></i><span class="tipbox" role="tooltip">Number of times your link was used to message Emmy.</span></button></dt>
                                <dd id="dashLeads">0</dd>
                            </div>
                            <div class="af-stat">
                                <dt>Orders <button type="button" class="af-tip" aria-label="What are orders?"><i class="ri-information-line" aria-hidden="true"></i><span class="tipbox" role="tooltip">Number of orders completed with your link.</span></button></dt>
                                <dd id="dashOrders">0</dd>
                            </div>
                        </dl>

                        <div>
                            <p class="af-label">Quick actions</p>
                            <div class="af-actions">
                                <a href="/partnership/affiliate/partner-kit" class="af-act"><i class="ri-tools-line" aria-hidden="true"></i> Access social media toolkit</a>
                                <a href="/asset/Emmy_STACK01_Handbook_v1.3.pdf" download="Emmy_STACK01_Handbook.pdf" class="af-act"><i class="ri-file-download-line" aria-hidden="true"></i> Download partner handbook (PDF)</a>
                                <a href="https://wa.me/2349076991076" id="supportLink" class="af-act" target="_blank" rel="noopener noreferrer"><i class="ri-customer-service-2-line" aria-hidden="true"></i> Chat with support</a>
                            </div>
                        </div>
                    </div>

                    <div class="af-stack">
                        <div>
                            <label class="af-label" for="shortLink" style="display:block">Your unique referral link</label>
                            <div class="af-linkbox">
                                <input type="text" id="shortLink" readonly placeholder="Generating link…">
                                <button type="button" class="af-copy" id="copyLinkBtn">Copy link</button>
                            </div>
                            <p class="af-code">Code: <strong id="displayCodeDash">------</strong> <button type="button" class="af-copy" id="copyCodeBtn" style="padding:0 .8rem">Copy</button></p>
                        </div>

                        <div class="af-note">
                            <i class="ri-information-line" aria-hidden="true"></i>
                            <span><strong>Currency note:</strong> commissions are calculated on the final sale amount. Cross-currency payouts (for example NGN to USDT) use the market rate at the time of transfer.</span>
                        </div>

                        <button type="button" id="logoutBtn" class="af-out">Sign out</button>
                    </div>
                </div>
                <section class="af-devices" id="devicesBox" aria-labelledby="devTitle" hidden>
                    <div class="af-dev-head">
                        <h3 id="devTitle">Signed-in devices</h3>
                        <button type="button" class="af-dev-all" id="devOthersBtn" hidden>Sign out all other devices</button>
                    </div>
                    <p class="af-dev-sub" id="devSub">Where your partner account is open right now.</p>
                    <ul class="af-dev-list" id="devList"></ul>
                </section>
                <p class="af-dash-msg" id="dashMsg" role="status" aria-live="polite"></p>
            </div>
        </section>
    </main>

    <footer class="footer">
        <div class="footer-container">
            <div class="footer-column"><h3><i class="ri-share-forward-box-line"></i> Ecosystem Hub</h3><ul>
                <li><a href="/">Home</a></li><li><a href="/websites">Websites</a></li><li><a href="/products">Products</a></li><li><a href="/pricing">Pricing</a></li><li><a href="/articles">Articles</a></li></ul></div>
            <div class="footer-column"><h3><i class="ri-rocket-2-line"></i> Flagship Product</h3><ul>
                <li><a href="/products/digital-business-card">Digital Business Card</a></li>
                <li><a href="/products/digital-business-card#demo">Live Demos</a></li>
                <li><a href="/products/digital-business-card#launch-package">Build Your Card</a></li>
                <li><a href="/payment" rel="nofollow">Payment <i class="ri-verified-badge-fill"></i></a></li></ul></div>
            <div class="footer-column"><h3><i class="ri-tools-line"></i> Technical Tools</h3><ul>
                {tools.map((t) => <li><a href={`/tools/${t.s}`}>{t.n}</a></li>)}</ul></div>
            <div class="footer-column"><h3><i class="ri-team-line"></i> Partnership</h3><ul>
                <li><a href="/partnership">Partnership Program</a></li><li><a href="/partnership/affiliate">Affiliate Portal</a></li><li><a href="/partnership/policy">Partner Policy</a></li></ul></div>
        </div>
        <div class="footer-bottom">
            <div class="footer-legal">
                <SocialLinks />
                <p>&copy; <span class="year"></span> Emmy STACK01. All Rights Reserved.</p>
            </div>
        </div>
    </footer>

<script is:inline>
document.addEventListener("DOMContentLoaded", () => {
  const $ = (s, r = document) => r.querySelector(s), $$ = (s, r = document) => [...r.querySelectorAll(s)];
  const drawer = $("#drawer"), overlay = $("#overlay"), openBtn = $("#openMenu");
  const setDrawer = (open) => {
    drawer.classList.toggle("open", open); overlay.classList.toggle("open", open);
    drawer.setAttribute("aria-hidden", String(!open)); openBtn.setAttribute("aria-expanded", String(open));
    document.body.classList.toggle("no-scroll", open);
    if (open) $("#closeMenu").focus(); else openBtn.focus({ preventScroll: true });
  };
  openBtn.addEventListener("click", () => setDrawer(true));
  $("#closeMenu").addEventListener("click", () => setDrawer(false));
  overlay.addEventListener("click", () => setDrawer(false));
  $$("#drawer a").forEach((a) => a.addEventListener("click", () => setDrawer(false)));
  const toolsBtn = $("#toolsBtn");
  toolsBtn.addEventListener("click", () => {
    const o = $("#toolsMenu").classList.toggle("open");
    toolsBtn.classList.toggle("open", o); toolsBtn.setAttribute("aria-expanded", String(o));
  });
  const dd = $(".js-dropdown"), ddBtn = $(".dropbtn", dd);
  ddBtn.addEventListener("click", (e) => { e.stopPropagation(); ddBtn.setAttribute("aria-expanded", String(dd.classList.toggle("open"))); });
  document.addEventListener("click", () => { dd.classList.remove("open"); ddBtn.setAttribute("aria-expanded", "false"); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && drawer.classList.contains("open")) setDrawer(false); });
});
</script>
<script is:inline>
(() => {
  const WA = "2349076991076";
  const $ = (id) => document.getElementById(id);
  const root = document.documentElement;
  const say = (el, text, kind) => { el.textContent = text || ""; el.className = el.className.replace(/\b(err|ok)\b/g, "").trim() + (kind ? " " + kind : ""); };
  const hint = (on) => { try { on ? localStorage.setItem("emmyPartner", "1") : localStorage.removeItem("emmyPartner"); } catch (e) {} };

  // The browser never holds a password or token: the server keeps the session in an httpOnly cookie.
  const api = async (path, body) => {
    const res = await fetch(path, body === undefined ? { credentials: "same-origin" } : { method: "POST", credentials: "same-origin", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
    let data = {}; try { data = await res.json(); } catch (e) {}
    return { ok: res.ok, status: res.status, data };
  };

  /* 1. Tooltips: hover/focus via CSS, tap to toggle on touch */
  document.querySelectorAll(".af-tip").forEach((t) => {
    t.addEventListener("click", (e) => { e.stopPropagation(); const o = !t.classList.contains("open"); document.querySelectorAll(".af-tip.open").forEach((x) => x.classList.remove("open")); t.classList.toggle("open", o); });
  });
  document.addEventListener("click", () => document.querySelectorAll(".af-tip.open").forEach((x) => x.classList.remove("open")));
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") document.querySelectorAll(".af-tip.open").forEach((x) => x.classList.remove("open")); });

  /* 2. Steps */
  const steps = { email: $("emailForm"), code: $("codeForm"), profile: $("profileForm") };
  const focusOf = { email: "email", code: "otp", profile: "firstName" };
  const step = (name, focus = true) => { Object.entries(steps).forEach(([k, f]) => { f.hidden = k !== name; }); if (focus) $(focusOf[name]).focus({ preventScroll: true }); };
  let pendingEmail = "";

  const bank = ["bankName", "accountName", "accountNumber"], crypto = ["cryptoName", "cryptoNetwork", "walletAddress"];
  const method = $("paymentMethod");
  const syncMethod = () => {
    $("bankDetails").hidden = method.value !== "bank";
    $("cryptoDetails").hidden = method.value !== "crypto";
    bank.forEach((id) => { $(id).required = method.value === "bank"; });
    crypto.forEach((id) => { $(id).required = method.value === "crypto"; });
  };
  method.addEventListener("change", syncMethod);

  const validate = (form) => {
    const bad = [...form.querySelectorAll("input, select")].find((el) => !el.closest("[hidden]") && !el.checkValidity());
    if (bad) { bad.focus(); return bad.type === "email" && bad.value ? "Please enter a valid email address." : "Please fill in all the required fields."; }
    return "";
  };

  /* 3. Dashboard */
  let partner = null;
  const showDashboard = (p) => {
    partner = p; hint(true); root.classList.add("af-session");
    const code = p.code;
    $("displayCodeDash").textContent = code;
    $("dashClicks").textContent = p.clicks ?? 0; $("dashLeads").textContent = p.leads ?? 0; $("dashOrders").textContent = p.orders ?? 0;
    $("shortLink").value = `https://emmystack01.com/go/?id=${code}`;
    $("supportLink").href = `https://wa.me/${WA}?text=${encodeURIComponent(`Hey Emmy, I'm an affiliate (Code: ${code}). I need help.`)}`;

    loadDevices();
  };
  const showGuest = (name = "email") => { partner = null; hint(false); root.classList.remove("af-session"); step(name, false); };

  /* 4. Send code (new and returning partners use the same step) */
  let cooldownTimer = 0;
  const cooldown = (secs) => {
    const b = $("resendBtn"); clearInterval(cooldownTimer); b.disabled = true;
    let left = secs; b.textContent = `Send a new code (${left}s)`;
    cooldownTimer = setInterval(() => { left -= 1; if (left <= 0) { clearInterval(cooldownTimer); b.disabled = false; b.textContent = "Send a new code"; } else b.textContent = `Send a new code (${left}s)`; }, 1000);
  };
  const sendCode = async (email, msg) => {
    const r = await api("/api/partner/otp", { email });
    if (!r.ok) { say(msg, r.data.error || "We couldn't send the code. Please try again.", "err"); return false; }
    return true;
  };

  steps.email.addEventListener("submit", async (e) => {
    e.preventDefault();
    const msg = $("emailMsg"), btn = $("emailBtn"), label = $("emailText");
    const err = validate(steps.email); if (err) return say(msg, err, "err");
    pendingEmail = $("email").value.trim();
    btn.disabled = true; label.textContent = "Sending…"; say(msg, "");
    try {
      if (await sendCode(pendingEmail, msg)) {
        $("sentTo").textContent = pendingEmail; $("otp").value = ""; say($("codeMsg"), "");
        step("code"); cooldown(60);
      }
    } catch (x) { say(msg, "Connection problem. Check your internet and try again.", "err"); }
    finally { btn.disabled = false; label.textContent = "Email me a code"; }
  });

  $("resendBtn").addEventListener("click", async () => {
    const msg = $("codeMsg"); say(msg, "");
    try { if (await sendCode(pendingEmail, msg)) { say(msg, "A new code is on its way.", "ok"); cooldown(60); } }
    catch (x) { say(msg, "Connection problem. Check your internet and try again.", "err"); }
  });
  $("changeEmailBtn").addEventListener("click", () => { clearInterval(cooldownTimer); step("email"); });

  /* 5. Verify the code */
  steps.code.addEventListener("submit", async (e) => {
    e.preventDefault();
    const msg = $("codeMsg"), btn = $("codeBtn"), label = $("codeText");
    const err = validate(steps.code); if (err) return say(msg, "Enter the code from your email.", "err");
    btn.disabled = true; label.textContent = "Checking…"; say(msg, "");
    try {
      const r = await api("/api/partner/verify", { email: pendingEmail, code: $("otp").value.trim() });
      if (!r.ok) return say(msg, r.data.error || "That code didn't work. Please try again.", "err");
      if (r.data.partner) { showDashboard(r.data.partner); window.scrollTo({ top: 0 }); }
      else { step("profile"); }
    } catch (x) { say(msg, "Connection problem. Check your internet and try again.", "err"); }
    finally { btn.disabled = false; label.textContent = "Verify and continue"; }
  });

  /* 6. Profile (new partners) */
  steps.profile.addEventListener("submit", async (e) => {
    e.preventDefault();
    const msg = $("regMsg"), btn = $("submitBtn"), label = $("btnText");
    const err = validate(steps.profile); if (err) return say(msg, err, "err");
    btn.disabled = true; label.textContent = "Creating your link…"; say(msg, "");
    const v = (id) => $(id).value.trim();
    try {
      // The server creates the code and sets the counters; the email comes from your verified login.
      const r = await api("/api/partner/register", {
        firstName: v("firstName"), lastName: v("lastName"), method: method.value,
        bankName: v("bankName"), accountName: v("accountName"), accountNumber: v("accountNumber"),
        cryptoName: v("cryptoName"), cryptoNetwork: v("cryptoNetwork"), walletAddress: v("walletAddress"),
      });
      if (r.status === 401) { showGuest("email"); return say($("emailMsg"), "Your session ended. Please sign in again.", "err"); }
      if (!r.ok || !r.data.partner) return say(msg, r.data.error || "Something went wrong. Please try again.", "err");
      showDashboard(r.data.partner); window.scrollTo({ top: 0 });
    } catch (x) { say(msg, "Connection problem. Check your internet and try again.", "err"); }
    finally { btn.disabled = false; label.textContent = "Join program"; }
  });

  /* 7. Refresh */
  const load = async (manual) => {
    const btn = $("refreshBtn"), msg = $("dashMsg");
    if (manual) { btn.disabled = true; btn.classList.add("spin"); }
    try {
      const r = await api("/api/partner/me");
      if (r.status === 401) { showGuest("email"); if (manual) say($("emailMsg"), "Please sign in again.", "err"); return; }
      if (!r.ok) { if (manual) say(msg, "Could not refresh. Please try again.", "err"); else if (!partner) showGuest("email"); return; }
      if (r.data.partner) { showDashboard(r.data.partner); if (manual) say(msg, "Stats updated."); }
      else { showGuest("profile"); }   // signed in but never finished the profile
    } catch (x) {
      if (manual) say(msg, "Could not refresh. Check your connection.", "err"); else if (!partner) showGuest("email");
    } finally {
      if (manual) setTimeout(() => { btn.disabled = false; btn.classList.remove("spin"); setTimeout(() => say(msg, ""), 2500); }, 400);
    }
  };
  $("refreshBtn").addEventListener("click", () => load(true));

  /* 7b. Signed-in devices. Everything from the server is shown with textContent, never as HTML. */
  const parseUA = (ua) => {
    ua = String(ua || "");
    if (!ua) return { title: "Unknown device", kind: "desktop" };
    const os = /Windows/i.test(ua) ? "Windows" : /iPhone/i.test(ua) ? "iPhone" : /iPad/i.test(ua) ? "iPad" : /Android/i.test(ua) ? "Android" : /CrOS/i.test(ua) ? "ChromeOS" : /Mac OS X|Macintosh/i.test(ua) ? "Mac" : /Linux/i.test(ua) ? "Linux" : "";
    const br = /Edg(e|A|iOS)?\//i.test(ua) ? "Edge" : /OPR\/|Opera/i.test(ua) ? "Opera" : /SamsungBrowser/i.test(ua) ? "Samsung Internet" : /Firefox\/|FxiOS/i.test(ua) ? "Firefox" : /Chrome\/|CriOS/i.test(ua) ? "Chrome" : /Safari\//i.test(ua) ? "Safari" : "";
    const kind = /iPad|Tablet/i.test(ua) || (/Android/i.test(ua) && !/Mobile/i.test(ua)) ? "tablet" : /iPhone|Android|Mobile/i.test(ua) ? "mobile" : "desktop";
    return { title: br && os ? `${br} on ${os}` : br || os || "Unknown device", kind };
  };
  const ICON = { mobile: "ri-smartphone-line", tablet: "ri-tablet-line", desktop: "ri-computer-line" };
  const placeOf = (d) => {
    let country = "";
    try { if (d.country) { const n = new Intl.DisplayNames(["en"], { type: "region" }).of(d.country); country = n && !/unknown/i.test(n) ? n : ""; } } catch (e) { country = ""; }
    return [d.city, country].filter(Boolean).join(", ") || "Location unknown";
  };
  const agoOf = (iso) => {
    const secs = (Date.now() - new Date(iso).getTime()) / 1000;
    if (!isFinite(secs) || secs < 120) return "Active now";
    const rtf = new Intl.RelativeTimeFormat("en", { numeric: "auto" });
    const [n, unit] = secs < 3600 ? [Math.round(secs / 60), "minute"] : secs < 86400 ? [Math.round(secs / 3600), "hour"] : [Math.round(secs / 86400), "day"];
    return "Active " + rtf.format(-n, unit);
  };
  const devBusy = (on) => { document.querySelectorAll(".af-dev-out, .af-dev-all").forEach((b) => { b.disabled = on; }); };

  const renderDevices = (list) => {
    const ul = $("devList"); ul.textContent = "";
    list.forEach((d) => {
      const info = parseUA(d.user_agent), li = document.createElement("li");
      li.className = "af-dev" + (d.current ? " current" : "");
      const ic = document.createElement("i"); ic.className = ICON[info.kind]; ic.setAttribute("aria-hidden", "true");
      const main = document.createElement("div"); main.className = "af-dev-main";
      const t = document.createElement("div"); t.className = "af-dev-title";
      const name = document.createElement("span"); name.textContent = info.title; t.appendChild(name);
      if (d.current) { const tag = document.createElement("span"); tag.className = "af-tag"; tag.textContent = "This device"; t.appendChild(tag); }
      const meta = document.createElement("div"); meta.className = "af-dev-meta";
      meta.textContent = `${placeOf(d)} \u00b7 ${d.current ? "Active now" : agoOf(d.last_active)}`;
      meta.title = "Signed in " + new Date(d.signed_in).toLocaleString();
      main.append(t, meta); li.append(ic, main);
      if (!d.current) {
        const b = document.createElement("button"); b.type = "button"; b.className = "af-dev-out"; b.textContent = "Sign out";
        b.setAttribute("aria-label", "Sign out " + info.title + ", " + placeOf(d));
        b.addEventListener("click", () => revokeDevice(d.id, info.title));
        li.appendChild(b);
      }
      ul.appendChild(li);
    });
    const others = list.filter((d) => !d.current).length;
    $("devOthersBtn").hidden = others === 0;
    $("devSub").textContent = others === 0 ? "This is the only device signed in to your partner account." : "Not you? Sign out a device you don't recognise, then sign back in here with a fresh email code.";
    $("devicesBox").hidden = false;
  };

  const loadDevices = async () => {
    try {
      const r = await api("/api/partner/devices");
      if (r.status === 401) { showGuest("email"); return; }
      if (!r.ok || !Array.isArray(r.data.devices)) { $("devicesBox").hidden = true; return; }   // e.g. database step not run yet: hide quietly
      renderDevices(r.data.devices);
    } catch (x) { /* keep whatever is showing */ }
  };

  const revokeDevice = async (id, title) => {
    if (!confirm(`Sign out ${title}? It will need a new email code to get back in.`)) return;
    const msg = $("dashMsg"); devBusy(true); say(msg, "");
    try {
      const r = await api("/api/partner/devices", { action: "revoke", id });
      if (r.status === 401) { showGuest("email"); return say($("emailMsg"), "Please sign in again.", "err"); }
      say(msg, r.ok ? "Device signed out." : (r.data.error || "We couldn't sign that device out."), r.ok ? "" : "err");
    } catch (x) { say(msg, "Connection problem. Check your internet and try again.", "err"); }
    finally { devBusy(false); loadDevices(); setTimeout(() => say(msg, ""), 4000); }
  };
  $("devOthersBtn").addEventListener("click", async () => {
    if (!confirm("Sign out of all other devices? You will stay signed in on this one.")) return;
    const msg = $("dashMsg"); devBusy(true); say(msg, "");
    try {
      const r = await api("/api/partner/devices", { action: "others" });
      if (r.status === 401) { showGuest("email"); return say($("emailMsg"), "Please sign in again.", "err"); }
      say(msg, r.ok ? "All other devices signed out." : (r.data.error || "We couldn't sign the other devices out."), r.ok ? "" : "err");
    } catch (x) { say(msg, "Connection problem. Check your internet and try again.", "err"); }
    finally { devBusy(false); loadDevices(); setTimeout(() => say(msg, ""), 4000); }
  });

  /* 8. Copy + sign out */
  const copy = async (text, btn, done) => {
    const old = btn.textContent;
    try { await navigator.clipboard.writeText(text); btn.textContent = done; }
    catch (x) { const i = $("shortLink"); i.select(); btn.textContent = "Press Ctrl+C"; }
    setTimeout(() => { btn.textContent = old; }, 2000);
  };
  $("copyLinkBtn").addEventListener("click", () => copy($("shortLink").value, $("copyLinkBtn"), "Copied!"));
  $("copyCodeBtn").addEventListener("click", () => copy($("displayCodeDash").textContent, $("copyCodeBtn"), "Copied!"));
  $("logoutBtn").addEventListener("click", async () => {
    if (!confirm("Sign out of the Emmy STACK01 dashboard?")) return;
    try { await api("/api/partner/logout", {}); } catch (x) {}
    hint(false); location.reload();
  });

  /* 9. On load: ask the server who is signed in. A visit with no cookie shows the sign-up card. */
  load(false);
})();
</script>
<script src="/script/year.js" defer></script>
</body>
</html>
