                                    <option value="crypto">Crypto wallet (USDT)</option>
                                </select>
                            </div>

                            <fieldset class="af-group" id="bankDetails" hidden>
                                <legend class="sr-only">Bank details</legend>
                                <div class="af-field"><label for="bankName">Bank name</label><input class="af-input" type="text" id="bankName" autocomplete="off"></div>
                                <div class="af-field"><label for="accountName">Account name</label><input class="af-input" type="text" id="accountName" autocomplete="off"></div>
                                <div class="af-field"><label for="accountNumber">Account number</label><input class="af-input" type="text" id="accountNumber" inputmode="numeric" autocomplete="off"></div>
                            </fieldset>

                            <fieldset class="af-group" id="cryptoDetails" hidden>
                                <legend class="sr-only">Crypto wallet details</legend>
                                <div class="af-field"><label for="cryptoName">Crypto name</label><input class="af-input" type="text" id="cryptoName" placeholder="e.g. USDT" autocomplete="off"></div>
                                <div class="af-field"><label for="cryptoNetwork">Blockchain (network)</label><input class="af-input" type="text" id="cryptoNetwork" placeholder="e.g. TRC20" autocomplete="off"></div>
                                <div class="af-field"><label for="walletAddress">Wallet address</label><input class="af-input" type="text" id="walletAddress" autocomplete="off" spellcheck="false"></div>
                                <p class="af-warn"><strong>Important:</strong> make sure your wallet address and network are 100% accurate. Emmy STACK01 is not responsible for funds lost due to an incorrect address. Blockchain transactions are irreversible.</p>
                            </fieldset>

                            <button type="submit" id="submitBtn" class="cta af-submit"><span id="btnText">Join program</span></button>
