---
import Analytics from '@vercel/analytics/astro';
export const prerender = true;
import SocialLinks from "../../../components/SocialLinks.astro";
// src/pages/partnership/affiliate/index.astro — Styles: /style/index-style.css + /style/affiliate-style.css
const site = "https://emmystack01.com";
const url = `${site}/partnership/affiliate`;
const title = 'Partner with Emmy STACK01 | Earn by Spreading the Word';
const desc = 'Join the Emmy STACK01 Partnership Program. Recommend high-quality brand identity and web development services to your network and earn 16.67% on every order.';
const ogTitle = 'Earn with the Emmy STACK01 Partnership Program';
const ogDesc = 'Get your unique affiliate code today and start earning 16.67% by referring clients for UI/UX design and high-performance web development.';
const ogImage = `${site}/asset/og-affiliate.png`;
const tools = [
  { n: "Website Auditor", s: "website-auditor", i: "ri-shield-check-line" },
  { n: "Social Architect", s: "social-architect", i: "ri-node-tree" },
  { n: "Meeting Studio", s: "meeting_background_studio", i: "ri-vidicon-line" },
  { n: "PDF Signer", s: "emmy-sign", i: "ri-file-pdf-2-line" },
  { n: "Invoice Generator", s: "naira-wise", i: "ri-bill-line" },
];
const org = { "@type": "Organization", "@id": `${site}/#organization`, name: "Emmy STACK01", url: `${site}/`, logo: `${site}/asset/emmy-stack01-logo.svg`, image: ogImage, sameAs: ["https://x.com/Emmy_STACK01", "https://wa.me/2349076991076"] };
const tiers = [
  { name: "Starter / Business Card Site", price: 60, earn: "$10" },
  { name: "Professional 1-Page Site", price: 105, earn: "$17.50" },
  { name: "Professional 2-Page Site", price: 175, earn: "$29.17" },
];
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebPage", "@id": `${url}#webpage`, url, name: title, description: desc, isPartOf: { "@type": "WebSite", "@id": `${site}/#website`, url: `${site}/`, name: "Emmy STACK01" }, publisher: { "@id": `${site}/#organization` }, inLanguage: "en-US",
      potentialAction: { "@type": "RegisterAction", target: url, description: "Register to become an affiliate partner, get a unique referral code and earn 16.67% recurring commission on orders." } },
    org,
    { "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: `${site}/` }, { "@type": "ListItem", position: 2, name: "Partnership", item: `${site}/partnership` }, { "@type": "ListItem", position: 3, name: "Affiliate", item: url }] },
  ],
};
