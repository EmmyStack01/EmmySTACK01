---
export const prerender = true;
import SocialLinks from "../../components/SocialLinks.astro";

// Emmy STACK01 — products page (/products). Styles: /style/index-style.css + /style/products-style.css
const site = "https://emmystack01.com";
const url = `${site}/products`;
const org = `${site}/#organization`;
const title = "Digital Products | Emmy STACK01";
const desc = "Explore digital products from Emmy STACK01, including our Digital Business Card for creators, entrepreneurs and professionals.";
const ogDesc = "Explore Emmy STACK01 digital products, including our professional Digital Business Card.";
const ogImage = `${site}/asset/Checkout-our-Demos.png`;
const productUrl = `${site}/products/digital-business-card`;
// Tip: rename this file to remove the spaces (e.g. checkout-our-demos-preview.png) and update the path here.
const cardImage = "/asset/" + encodeURIComponent("Checkout our Demos_20260508_194921_0000.png");

const tools = [
  { n: "Website Auditor", s: "website-auditor", i: "ri-shield-check-line" },
  { n: "Social Architect", s: "social-architect", i: "ri-node-tree" },
  { n: "Meeting Studio", s: "meeting_background_studio", i: "ri-vidicon-line" },
  { n: "PDF Signer", s: "emmy-sign", i: "ri-file-pdf-2-line" },
  { n: "Invoice Generator", s: "naira-wise", i: "ri-bill-line" },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemPage", "@id": `${url}#webpage`, url, name: title, description: ogDesc,
      isPartOf: { "@type": "WebSite", "@id": `${site}/#website`, name: "Emmy STACK01", url: site },
      mainEntity: [
        {
          "@type": "Product", "@id": `${url}#digital-business-card`, name: "Digital Business Card Website",
          description: "A professional digital business card website built to share contact details, social links, work and services from one online profile.",
          image: ogImage, brand: { "@type": "Brand", name: "Emmy STACK01" },
          aggregateRating: { "@type": "AggregateRating", ratingValue: "4.5", reviewCount: "2", bestRating: "5", worstRating: "1" },
          review: [
            { "@type": "Review", author: { "@type": "Person", name: "Abbey" }, reviewRating: { "@type": "Rating", ratingValue: "4" },
              reviewBody: "The website has been great for me. It makes people easily know what I’m about and how to reach me. It has mostly been useful for my WhatsApp community, creating an easy way to connect with new minds.",
              publisher: { "@type": "Organization", name: "Google Business Profile" } },
            { "@type": "Review", author: { "@type": "Person", name: "Prosper Zekeli" }, reviewRating: { "@type": "Rating", ratingValue: "5" },
              reviewBody: "Honestly speaking I checked out Emmy Stack , it’s a neat and great tool for anyone looking to build an online presence quickly. The way it turns links into a searchable domain is clever you literally just click and Google can find it. Super simple to use, and it gives your project or profile a professional touch without overcomplicating things. It's really worth it 🔥 The setup was smooth and fast, and the interface is very user-friendly. It helps me manage my online presence more efficiently, and I can easily access or share my links whenever I need to. Overall, it’s a very useful tool for anyone who wants to keep their social accounts organized and accessible in one place. I’d definitely recommend it for convenience and ease of use.",
              publisher: { "@type": "Organization", name: "Google Business Profile & Trustpilot" } },
          ],
          offers: {
            "@type": "Offer", price: "60.00", priceCurrency: "USD", availability: "https://schema.org/InStock", url: productUrl, category: "Digital Goods",
            seller: { "@type": "Organization", "@id": org, name: "Emmy STACK01", url: site },
            shippingDetails: {
              "@type": "OfferShippingDetails",
              shippingDestination: { "@type": "DefinedRegion", addressCountry: "US" },
              shippingRate: { "@type": "MonetaryAmount", value: "0.00", currency: "USD" },
              deliveryTime: {
                "@type": "ShippingDeliveryTime",
                handlingTime: { "@type": "QuantitativeValue", minValue: 0, maxValue: 0, unitCode: "DAY" },
                transitTime: { "@type": "QuantitativeValue", minValue: 0, maxValue: 0, unitCode: "DAY" },
              },
            },
            hasMerchantReturnPolicy: {
              "@type": "MerchantReturnPolicy",
              applicableCountry: [{ "@type": "Country", name: "NG" }, { "@type": "Country", name: "US" }],
              returnPolicyCategory: "https://schema.org/MerchantReturnNotPermitted", returnPolicyType: "https://schema.org/NoReturns",
            },
          },
        },
      ],
    },
  ],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <script src="/script/meta-logic.js" is:inline></script>
    <title>{title}</title>
    <meta name="description" content={desc}>
    <link rel="canonical" href={url}>
    <meta name="robots" content="index, follow">
    <meta name="author" content="Emmy STACK01">

    <link rel="stylesheet" href="/style/index-style.css">
    <link rel="stylesheet" href="/style/products-style.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Manrope:wght@400..800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.7.0/fonts/remixicon.css" rel="stylesheet">

    <link rel="apple-touch-icon" sizes="180x180" href={`${site}/favicon_io/apple-touch-icon.png`}>
    <link rel="icon" type="image/png" sizes="32x32" href={`${site}/favicon_io/favicon-32x32.png`}>
    <link rel="icon" type="image/png" sizes="16x16" href={`${site}/favicon_io/favicon-16x16.png`}>
    <link rel="manifest" href={`${site}/favicon_io/site.webmanifest`}>

    <meta property="og:site_name" content="Emmy STACK01">
    <meta property="og:type" content="website">
    <meta property="og:url" content={url}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={ogDesc}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:image:alt" content="Emmy STACK01 Business Card Demos">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@Emmy_STACK01">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={ogDesc}>
    <meta name="twitter:image" content={ogImage}>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js" defer></script>
    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
</head>
<body>
    <div id="loader" aria-hidden="true"><span class="spinner"></span><p>Building your website…</p></div>

    <!-- Desktop nav -->
    <nav class="nav" aria-label="Main">
        <a class="logo" href="/">Emmy STACK01</a>
        <ul class="nav-links">
            <li><a href="/">Home</a></li>
            <li><a href="/websites">Websites</a></li>
            <li><a href="/products" aria-current="page">Product</a></li>
            <li class="dropdown js-dropdown">
                <button type="button" class="dropbtn" aria-expanded="false">Tools <i class="ri-arrow-down-s-line"></i></button>
                <div class="dropdown-content">
                    {tools.map((t) => <a href={`/tools/${t.s}`}><i class={t.i}></i> {t.n}</a>)}
                </div>
            </li>
            <li><a href="/partnership">Partnership Program <span class="earn-pill">EARN</span> </a></li>
            <li><a href="/articles">Articles</a></li>
        </ul>
        <a href="#project-modal" class="cta nav-cta trigger-project-modal">Start your project <i class="ri-arrow-right-line"></i></a>
    </nav>

    <!-- Mobile bar -->
    <div class="navbar">
        <a class="logo" href="/">Emmy STACK01</a>
        <button class="nav-toggle" id="openMenu" aria-label="Open navigation" aria-controls="drawer" aria-expanded="false">
            <span class="line"></span><span class="line"></span><span class="line"></span>
        </button>
    </div>

    <div class="overlay" id="overlay"></div>
    <aside class="drawer" id="drawer" aria-label="Site navigation" aria-hidden="true">
        <div class="drawer-header">
            <a class="logo" href="/">Emmy STACK01</a>
            <button id="closeMenu" class="close-btn" aria-label="Close navigation"><i class="ri-close-line"></i></button>
        </div>
        <nav class="drawer-nav">
            <a href="/" class="drawer-link"><i class="ri-home-line"></i> Home</a>
            <a href="/websites" class="drawer-link"><i class="ri-layout-4-line"></i> Websites</a>
            <a href="/products" class="drawer-link active" aria-current="page"><i class="ri-box-3-line"></i> Product</a>
            <button class="drawer-link dropdown-btn" id="toolsBtn" aria-expanded="false" aria-controls="toolsMenu">
                <i class="ri-tools-line"></i> Tools <i class="ri-arrow-down-s-line chev"></i>
            </button>
            <div class="submenu" id="toolsMenu"><div class="submenu-inner">
                {tools.map((t) => <a href={`/tools/${t.s}`}><i class={t.i}></i> {t.n}</a>)}
            </div></div>
            <a href="/partnership" class="drawer-link"><i class="ri-team-line"></i> Partnership Program <span class="earn-pill">EARN</span></a>
            <a href="/articles" class="drawer-link"><i class="ri-article-line"></i> Articles</a>
        </nav>
        <button class="cta project-btn trigger-project-modal">Start your project <i class="ri-arrow-right-line"></i></button>
        <div class="drawer-foot">
            <SocialLinks />
            <p>&copy; <span class="year"></span> Emmy STACK01. All rights reserved.</p>
        </div>
    </aside>

    <div id="project-modal" class="modal-overlay" aria-hidden="true">
        <div class="modal-content" role="dialog" aria-modal="true" aria-labelledby="modal-title">
            <button class="modal-close" id="close-modal" aria-label="Close"><i class="ri-close-line"></i></button>
            <h3 class="modal-title" id="modal-title">Connect via WhatsApp</h3>
            <p class="modal-text">Select how you’d like to get started with Emmy STACK01:</p>
            <div class="modal-actions">
                <a href="/thank-you.html?type=project" class="btn-modal btn-primary" target="_blank" rel="noopener"><i class="ri-rocket-2-line"></i> Start a Project</a>
                <a href="/thank-you.html?type=inquiry" class="btn-modal btn-secondary" target="_blank" rel="noopener"><i class="ri-question-answer-line"></i> Make an Inquiry</a>
            </div>
        </div>
    </div>

    <header class="pd-hero">
        <div class="pd-inner">
            <div class="pd-copy">
                <h1><span class="l1">Emmy STACK01</span><span class="l2">Digital products &amp; tools</span></h1>
                <p>Explore digital products and tools built by Emmy STACK01 for professionals, creators, entrepreneurs and modern businesses.</p>
                <a class="hero-cta" href="#products">Explore the stack</a>
            </div>
            <div class="pd-stage">
                <div class="pd-float">
                    <div class="pd-phone" id="phone">
                        <div class="pd-bar" aria-hidden="true"></div>
                        <video autoplay muted loop playsinline preload="metadata" aria-label="Preview of a digital business card website scrolling on a phone">
                            <source src="/asset/digital-business-card.webm" type="video/webm">
                        </video>
                        <div class="pd-glare" aria-hidden="true"></div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main>
        <section id="products" class="section pd-products" aria-labelledby="products-title">
            <div class="pd-head">
                <h2 class="sec-title" id="products-title">Digital products</h2>
                <div class="accent-line"></div>
            </div>

            <div class="pd-grid">
                <article class="pd-card reveal">
                    <div class="pd-body">
                        <span class="pd-badge">Flagship</span>
                        <h3>Digital Business Card Website</h3>
                        <p class="desc">A professional digital business card website built to share your contact details, social links, work and services from one simple online profile.</p>
                        <div class="pd-foot">
                            <p class="pd-price"><small>One-time</small><strong>$60</strong></p>
                            <a href="/products/digital-business-card" class="btn-white">View product</a>
                        </div>
                    </div>

                    <a href="/products/digital-business-card" class="pd-visual" id="visual" aria-label="View the Digital Business Card Website product">
                        <img src={cardImage} alt="Emmy STACK01 digital business card website interface" loading="lazy" decoding="async">
                        <span class="pd-chip" aria-hidden="true">View product <i class="ri-arrow-right-up-line"></i></span>
                    </a>
                </article>
            </div>
            <p class="pd-more">More products are on the way. Meanwhile, try our <a href="/tools/website-auditor">free tools</a>.</p>
        </section>
    </main>

    <footer class="footer">
        <div class="footer-container">
            <div class="footer-column"><h3><i class="ri-share-forward-box-line"></i> Ecosystem Hub</h3><ul>
                <li><a href="/">Home</a></li><li><a href="/websites">Websites</a></li><li><a href="/products">Products</a></li><li><a href="/pricing">Pricing</a></li><li><a href="/articles">Articles</a></li></ul></div>
            <div class="footer-column"><h3><i class="ri-rocket-2-line"></i> Flagship Product</h3><ul>
                <li><a href="/products/digital-business-card">Digital Business Card</a></li>
                <li><a href="/products/digital-business-card#demo">Live Demos</a></li>
                <li><a href="/products/digital-business-card#launch-package">Build Your Card</a></li>
                <li><a href="/payment" rel="nofollow">Payment <i class="ri-verified-badge-fill"></i></a></li></ul></div>
            <div class="footer-column"><h3><i class="ri-tools-line"></i> Technical Tools</h3><ul>
                {tools.map((t) => <li><a href={`/tools/${t.s}`}>{t.n}</a></li>)}</ul></div>
            <div class="footer-column"><h3><i class="ri-team-line"></i> Partnership</h3><ul>
                <li><a href="/partnership">Partnership Program</a></li><li><a href="/partnership/affiliate">Affiliate Portal</a></li><li><a href="/partnership/policy">Partner Policy</a></li></ul></div>
        </div>
        <div class="footer-bottom">
            <div class="footer-legal">
                <SocialLinks />
                <p>&copy; <span class="year"></span> Emmy STACK01. All Rights Reserved.</p>
            </div>
        </div>
    </footer>

<script is:inline>
document.addEventListener("DOMContentLoaded", () => {
  const $ = (s, r = document) => r.querySelector(s), $$ = (s, r = document) => [...r.querySelectorAll(s)];

  // Loader
  const loader = $("#loader"), hide = () => loader && loader.classList.add("done");
  window.addEventListener("load", hide); setTimeout(hide, 3000);

  // Drawer
  const drawer = $("#drawer"), overlay = $("#overlay"), openBtn = $("#openMenu");
  const setDrawer = (open) => {
    drawer.classList.toggle("open", open); overlay.classList.toggle("open", open);
    drawer.setAttribute("aria-hidden", String(!open)); openBtn.setAttribute("aria-expanded", String(open));
    document.body.classList.toggle("no-scroll", open);
    if (open) $("#closeMenu").focus(); else openBtn.focus({ preventScroll: true });
  };
  openBtn.addEventListener("click", () => setDrawer(true));
  $("#closeMenu").addEventListener("click", () => setDrawer(false));
  overlay.addEventListener("click", () => setDrawer(false));
  $$("#drawer a").forEach((a) => a.addEventListener("click", () => setDrawer(false)));
  const toolsBtn = $("#toolsBtn");
  toolsBtn.addEventListener("click", () => {
    const o = $("#toolsMenu").classList.toggle("open");
    toolsBtn.classList.toggle("open", o); toolsBtn.setAttribute("aria-expanded", String(o));
  });

  // Desktop dropdown (click for touch, hover/focus via CSS)
  const dd = $(".js-dropdown"), ddBtn = $(".dropbtn", dd);
  ddBtn.addEventListener("click", (e) => { e.stopPropagation(); ddBtn.setAttribute("aria-expanded", String(dd.classList.toggle("open"))); });
  document.addEventListener("click", () => { dd.classList.remove("open"); ddBtn.setAttribute("aria-expanded", "false"); });

  // Modal
  const modal = $("#project-modal"), closeBtn = $("#close-modal"); let lastFocus;
  const showModal = (open) => {
    modal.classList.toggle("is-active", open); modal.setAttribute("aria-hidden", String(!open));
    if (open) { lastFocus = document.activeElement; closeBtn.focus(); } else if (lastFocus) lastFocus.focus({ preventScroll: true });
  };
  $$(".trigger-project-modal").forEach((b) => b.addEventListener("click", (e) => { e.preventDefault(); setDrawer(false); showModal(true); }));
  closeBtn.addEventListener("click", () => showModal(false));
  modal.addEventListener("click", (e) => { if (e.target === modal) showModal(false); });
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    if (modal.classList.contains("is-active")) showModal(false);
    else if (drawer.classList.contains("open")) setDrawer(false);
  });

  // Fine pointers only: tilt the phone with the mouse, and let a "View product" chip follow the pointer over the image.
  const fine = matchMedia("(hover:hover) and (pointer:fine) and (prefers-reduced-motion:no-preference)").matches;
  if (fine && innerWidth >= 1024) {
    const phone = $("#phone");
    addEventListener("mousemove", (e) => {
      phone.style.setProperty("--ry", `${(e.clientX / innerWidth - .5) * 22}deg`);
      phone.style.setProperty("--rx", `${-(e.clientY / innerHeight - .5) * 22}deg`);
    }, { passive: true });

    const vis = $("#visual"), img = $("img", vis), chip = $(".pd-chip", vis);
    vis.addEventListener("mousemove", (e) => {
      const r = vis.getBoundingClientRect();
      vis.style.setProperty("--x", `${e.clientX - r.left + 14}px`);
      vis.style.setProperty("--y", `${e.clientY - r.top + 14}px`);
      img.style.setProperty("--ry", `${((e.clientX - r.left) / r.width - .5) * 16}deg`);
      img.style.setProperty("--rx", `${-((e.clientY - r.top) / r.height - .5) * 16}deg`);
      vis.classList.add("following");
    });
    vis.addEventListener("mouseleave", () => { vis.classList.remove("following"); img.style.setProperty("--ry", "0deg"); img.style.setProperty("--rx", "0deg"); });
  }
  if (matchMedia("(prefers-reduced-motion:reduce)").matches) { const v = $(".pd-phone video"); if (v) { v.removeAttribute("autoplay"); v.pause(); } }

  // Animation: nothing is hidden in CSS, so the page stays visible if GSAP fails to load
  if (!window.gsap || !window.ScrollTrigger) return;
  gsap.registerPlugin(ScrollTrigger);
  gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", () => {
    gsap.timeline({ defaults: { ease: "power4.out" } })
      .from(".pd-copy > *", { y: 28, opacity: 0, duration: .9, stagger: .12, clearProps: "all" })
      .from(".pd-stage", { scale: .85, opacity: 0, duration: 1.1, clearProps: "all" }, "-=.9");
    $$(".reveal").forEach((el) => gsap.from(el, { scrollTrigger: { trigger: el, start: "top 90%", once: true }, y: 50, opacity: 0, duration: 1, ease: "power3.out", clearProps: "all" }));
  });
});
</script>
<script src="/script/year.js" defer></script>
</body>
</html>
