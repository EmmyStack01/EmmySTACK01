---
export const prerender = true;
import SocialLinks from "../../components/SocialLinks.astro";

// Emmy STACK01 — Digital Business Card product page (/products/digital-business-card).
// Styles: /style/index-style.css + /style/digital-business-card-style.css
// Scripts: inline builder script below + /script/card.js (demo deck) + /script/year.js

const site = "https://emmystack01.com";
const url = `${site}/products/digital-business-card`;
const org = `${site}/#organization`;
const title = "Digital Business Card Website | Emmy STACK01";
const desc = "Get a professional digital business card website for sharing your contact details, social links, work and services. Fast, mobile-friendly and easy to share.";
const ogImage = `${site}/asset/og-digital-business-card.png`;
const price = 60; // flat price in USD (also used by the builder summary)

// Package preview (left card)
const features = [
  { i: "user-6-line",      t: "Identity Core",  d: "Image, Title, Bio & Tagline" },
  { i: "flashlight-line",  t: "Action Hub",     d: "Custom Buttons & Social Icons" },
  { i: "fingerprint-line", t: "VCard One-Tap",  d: "Save contact to phone instantly" },
  { i: "qr-code-line",     t: "Smart Sharing",  d: "QR Code & Native Share Button" },
  { i: "pulse-line",       t: "Dynamic Flow",   d: "Ticker Marquees & Video Embeds" },
];
const integrations = [
  { label: "Newsletters", items: [["kit", "Kit"], ["beehiiv", "Beehiiv"], ["substack", "Substack"]] },
  { label: "Bookings",    items: [["calcom", "Cal.com"], ["calendly", "Calendly"], ["setmore", "Setmore"]] },
  { label: "Location",    items: [["gmaps", "Google Maps"]] },
];
const addons = [
  { i: "ri-github-fill",       c: "#f5f5f5", t: "GitHub Deployment", d: "Live hosting on your own repository." },
  { i: "ri-global-line",       c: "#00ccff", t: "Domain Config",     d: "Setting up your custom www.name.com." },
  { i: "ri-google-fill",       c: "",        t: "Search Console",    d: "Index your site on Google instantly." },
  { i: "ri-terminal-box-line", c: "#34d399", t: "Custom CMS",        d: "Edit your content without writing code." },
];

// Builder drawer
const included = [["user-6-line", "Identity Core"], ["qr-code-line", "Smart Sharing"]];
const extras = [
  ["layout-grid-line", "Custom Buttons"], ["links-line", "Social Icons"], ["contacts-book-line", "vCard One-Tap"],
  ["news-line", "Ticker Marquees"], ["video-line", "Video Embeds"],
];
const groups = [
  { label: "Newsletter", items: ["Kit", "Beehiiv", "Substack"] },
  { label: "Bookings",   items: ["Cal.com", "Calendly", "Setmore"] },
  { label: "Location",   items: ["Google Maps"] },
];

// Demo deck (last card sits on top of the stack)
const demos = [
  { n: "Amara Okafor",   c: "#48cae4", u: "https://emmydemoweb3.netlify.app", img: "Amara_Okafor_wbgcpi" },
  { n: "Aisha Patel",    c: "#d4af37", u: "https://emmydemoweb2.netlify.app", img: "Aisha_Patel_i1ec8j" },
  { n: "Kofi Mensah",    c: "#ffb703", u: "https://emmydemoweb6.netlify.app", img: "Kofi_Mensah_gv4pel" },
  { n: "Jordan Banks",   c: "#00f5d4", u: "https://emmydemoweb5.netlify.app", img: "Jordan_Banks_nhl3mj" },
  { n: "Alex Rivera",    c: "#38bdf8", u: "https://emmydemoweb1.netlify.app", img: "Alex_Rivera_wvs50b" },
  { n: "Chloe Sterling", c: "#ccff00", u: "https://emmydemoweb4.netlify.app", img: "Chloe_Sterling_zzlwrq" },
];
const cdn = "https://res.cloudinary.com/dq7dwhxqn/image/upload/f_auto/q_auto/dpr_auto/w_300/";

const tools = [
  { s: "website-auditor", n: "Website Auditor" }, { s: "social-architect", n: "Social Architect" },
  { s: "meeting_background_studio", n: "Meeting Studio" }, { s: "naira-wise", n: "Invoice Generator" }, { s: "emmy-sign", n: "PDF Signer" },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage", "@id": `${url}#webpage`, url, name: title, description: desc,
      isPartOf: { "@type": "WebSite", "@id": `${site}/#website`, name: "Emmy STACK01", url: site },
    },
    {
      "@type": "Product", "@id": `${url}#product`, mainEntityOfPage: { "@id": `${url}#webpage` },
      name: "Digital Business Card Website",
      description: "A professional digital business card website built to share contact details, social links, work and services from one online profile.",
      image: ogImage, brand: { "@type": "Brand", name: "Emmy STACK01" },
      aggregateRating: { "@type": "AggregateRating", ratingValue: "4.5", reviewCount: "2", bestRating: "5", worstRating: "1" },
      review: [
        { "@type": "Review", author: { "@type": "Person", name: "Abbey" }, reviewRating: { "@type": "Rating", ratingValue: "4" },
          reviewBody: "The website has been great for me. It makes people easily know what I’m about and how to reach me. It has mostly been useful for my WhatsApp community, creating an easy way to connect with new minds.",
          publisher: { "@type": "Organization", name: "Google Business Profile" } },
        { "@type": "Review", author: { "@type": "Person", name: "Prosper Zekeli" }, reviewRating: { "@type": "Rating", ratingValue: "5" },
          reviewBody: "Honestly speaking I checked out Emmy Stack , it’s a neat and great tool for anyone looking to build an online presence quickly. The way it turns links into a searchable domain is clever you literally just click and Google can find it. Super simple to use, and it gives your project or profile a professional touch without overcomplicating things. It's really worth it 🔥 The setup was smooth and fast, and the interface is very user-friendly. It helps me manage my online presence more efficiently, and I can easily access or share my links whenever I need to. Overall, it’s a very useful tool for anyone who wants to keep their social accounts organized and accessible in one place. I’d definitely recommend it for convenience and ease of use.",
          publisher: { "@type": "Organization", name: "Google Business Profile & Trustpilot" } },
      ],
      offers: {
        "@type": "Offer", price: price.toFixed(2), priceCurrency: "USD", availability: "https://schema.org/InStock", url, category: "Digital Goods",
        shippingDetails: {
          "@type": "OfferShippingDetails",
          shippingDestination: { "@type": "DefinedRegion", addressCountry: "US" },
          shippingRate: { "@type": "MonetaryAmount", value: "0.00", currency: "USD" },
          deliveryTime: {
            "@type": "ShippingDeliveryTime",
            handlingTime: { "@type": "QuantitativeValue", minValue: 0, maxValue: 0, unitCode: "DAY" },
            transitTime: { "@type": "QuantitativeValue", minValue: 0, maxValue: 0, unitCode: "DAY" },
          },
        },
        hasMerchantReturnPolicy: {
          "@type": "MerchantReturnPolicy",
          applicableCountry: [{ "@type": "Country", name: "NG" }, { "@type": "Country", name: "US" }],
          returnPolicyCategory: "https://schema.org/MerchantReturnNotPermitted", returnPolicyType: "https://schema.org/NoReturns",
        },
        seller: { "@type": "Organization", "@id": org, name: "Emmy STACK01", url: site },
      },
    },
  ],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="/script/meta-logic.js" is:inline></script>
    <title>{title}</title>
    <meta name="description" content={desc}>
    <link rel="canonical" href={url}>
    <meta name="robots" content="index, follow">
    <meta name="author" content="Emmy STACK01">
    <meta name="theme-color" content="#0b1020">

    <link rel="apple-touch-icon" sizes="180x180" href="/favicon_io/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon_io/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon_io/favicon-16x16.png">
    <link rel="manifest" href="/favicon_io/site.webmanifest">

    <meta property="og:site_name" content="Emmy STACK01 | Digital DNA">
    <meta property="og:type" content="website">
    <meta property="og:url" content={url}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content="Create a professional digital business card website with contact sharing, social links, QR sharing and more.">
    <meta property="og:image" content={ogImage}>
    <meta property="og:image:alt" content="Emmy STACK01 Digital Business Card Interface Demos">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@Emmy_STACK01">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content="A professional digital business card website with contact sharing, social links, QR sharing and more.">
    <meta name="twitter:image" content={ogImage}>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Manrope:wght@400..800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.7.0/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="/style/index-style.css">
    <link rel="stylesheet" href="/style/digital-business-card-style.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js" defer></script>

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body>
    <header class="ch-hero">
        <div class="ch-top">
            <a class="logo" href="/" aria-label="Emmy STACK01 home">Emmy STACK01</a>
            <a class="ch-back" href="/products"><i class="ri-arrow-left-line" aria-hidden="true"></i> All products</a>
        </div>
        <div class="ch-inner">
            <div class="ch-copy">
                <h1><span class="l1">Digital Business Card</span><span class="l2">Built for your professional identity.</span></h1>
                <p>Get a professional digital business card website to share your contact details, social links, work and services from one simple online profile.</p>
                <div class="ch-actions">
                    <button type="button" class="hero-cta" data-open-builder>Build your card</button>
                    <a class="btn-ghost" href="#demo">View demos</a>
                </div>
            </div>

            <div class="ch-stage">
                <div class="ch-float">
                    <div class="ch-phone" id="phone">
                        <div class="ch-bar" aria-hidden="true"></div>
                        <video autoplay muted loop playsinline preload="metadata" aria-label="Preview of a digital business card website scrolling on a phone">
                            <source src="/asset/digital-business-card.webm" type="video/webm">
                        </video>
                        <div class="ch-glare" aria-hidden="true"></div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main>
        <section id="launch-package" class="package-section" aria-labelledby="pk-title">
            <div class="pk-head">
                <h2 class="sec-title" id="pk-title">Build your digital business card</h2>
                <div class="accent-line"></div>
            </div>

            <div class="pk-grid">
                <article class="pk-dark reveal">
                    <div class="pk-head-row"><i class="ri-stack-line" aria-hidden="true"></i><h3>Features</h3></div>
                    <ul class="pk-feats">
                        {features.map((f) => (
                            <li class="pk-feat">
                                <span class="ico"><i class={`ri-${f.i}`} aria-hidden="true"></i></span>
                                <span><strong>{f.t}</strong><span>{f.d}</span></span>
                            </li>
                        ))}
                    </ul>
                </article>

                <article class="pk-dark reveal">
                    <div class="pk-head-row"><i class="ri-apps-2-line" aria-hidden="true"></i><h3>Integrations</h3></div>
                    {integrations.map((g) => (
                        <div class="pk-sub">
                            <p class="pk-label">{g.label}</p>
                            <div class="pk-pills">{g.items.map(([c, n]) => <span class={`pill ${c}`}>{n}</span>)}</div>
                        </div>
                    ))}
                </article>

                <article class="pk-dark pk-wide reveal">
                    <div class="pk-head-row"><i class="ri-gift-line" aria-hidden="true"></i><h3>Complimentary add-ons</h3></div>
                    <div class="addons">
                        {addons.map((a) => (
                            <div class="addon">
                                <i class={a.i} style={a.c ? `color:${a.c}` : undefined} aria-hidden="true"></i>
                                <h4>{a.t}</h4>
                                <p>{a.d}</p>
                            </div>
                        ))}
                    </div>
                </article>
            </div>

            <div class="pk-cta">
                <p>Pick your features. One flat price of ${price}.</p>
                <button type="button" class="cta" data-open-builder>Build your stack</button>
            </div>
        </section>

        <section class="dm" id="demo" aria-labelledby="dm-title">
            <h2 id="dm-title">Digital business card demos</h2>
            <p class="lead">Tap a card to bring it forward, then open the live demo.</p>

            <div class="dm-deck" id="dmDeck" role="group" aria-label="Demo cards">
                {demos.map((d, i) => (
                    <div class="dm-card" style={`--i:${i};--c:${d.c}`}>
                        <button type="button" class="dm-pick" aria-pressed="false">
                            <img src={`${cdn}${d.img}`} alt={`Digital business card website demo for ${d.n}`} width="300" height="300" loading="lazy" decoding="async">
                            <span class="dm-name">{d.n}</span>
                        </button>
                        <a class="dm-go" href={d.u} target="_blank" rel="noopener noreferrer">View demo<span class="visually-hidden"> for {d.n} (opens in a new tab)</span> <i class="ri-external-link-line" aria-hidden="true"></i></a>
                    </div>
                ))}
            </div>

            <div class="dm-nav">
                <button type="button" data-dm="prev" aria-label="Previous demo"><i class="ri-arrow-left-s-line" aria-hidden="true"></i></button>
                <button type="button" data-dm="next" aria-label="Next demo"><i class="ri-arrow-right-s-line" aria-hidden="true"></i></button>
            </div>
        </section>
    </main>

    <!-- Floating builder button -->
    <button type="button" class="bd-fab" id="bdFab" data-open-builder aria-label="Open card builder, 2 features selected">
        <span class="bd-badge" id="bdBadge" aria-hidden="true">2</span>
        <i class="ri-shopping-cart-2-line" aria-hidden="true"></i>
        <span class="txt">Build your stack</span>
    </button>

    <!-- Builder drawer -->
    <div class="bd-overlay" id="bdOverlay"></div>
    <aside class="bd-drawer" id="bdDrawer" role="dialog" aria-modal="true" aria-labelledby="bdTitle" data-step="select">
        <div class="bd-handle" aria-hidden="true"></div>
        <button type="button" class="bd-close" id="bdClose" aria-label="Close builder"><i class="ri-close-line" aria-hidden="true"></i></button>

        <div class="bd-body" id="bdBody">
            <h2 id="bdTitle">Stack your features</h2>
            <p class="sub">Customize your digital business card website. Every feature you pick is included in the flat ${price}.</p>

            <div class="bd-pick">
                <div class="bd-sec">
                    <h3>Included</h3>
                    <div class="bd-list">
                        {included.map(([i, n]) => (
                            <div class="bd-chip locked"><i class={`ri-${i}`} aria-hidden="true"></i><span class="name">{n}</span><i class="ri-lock-fill state" aria-hidden="true"></i><span class="visually-hidden">included</span></div>
                        ))}
                    </div>
                </div>

                <div class="bd-sec">
                    <h3>More features</h3>
                    <div class="bd-list">
                        {extras.map(([i, n]) => (
                            <button type="button" class="bd-chip" data-name={n} aria-pressed="false"><i class={`ri-${i}`} aria-hidden="true"></i><span class="name">{n}</span><i class="ri-add-line state" aria-hidden="true"></i></button>
                        ))}
                    </div>
                </div>

                <div class="bd-sec">
                    <h3>Integrations <span class="visually-hidden">(choose one per group)</span></h3>
                    {groups.map((g) => (
                        <div class="bd-int" role="group" aria-label={g.label}>
                            {g.items.map((n) => (
                                <button type="button" class="bd-chip" data-name={n} data-group={g.label} aria-pressed="false"><span class="name">{n}</span><i class="ri-add-line state" aria-hidden="true"></i></button>
                            ))}
                        </div>
                    ))}
                </div>
            </div>

            <div class="bd-sum" aria-live="polite">
                <div class="bd-total">
                    <p>Total investment</p>
                    <strong>${price}</strong>
                    <small>One-time payment</small>
                </div>
                <ul class="bd-tags" id="bdTags" aria-label="Your selected features"></ul>
                <ul class="bd-trust">
                    <li><i class="ri-flashlight-line" aria-hidden="true"></i> Ready in 24–48 hours</li>
                    <li><i class="ri-shield-check-line" aria-hidden="true"></i> Pay after your site is ready</li>
                    <li><i class="ri-loop-left-line" aria-hidden="true"></i> One-time payment • Lifetime access</li>
                </ul>
            </div>
        </div>

        <div class="bd-foot">
            <button type="button" class="bd-edit" id="bdEdit"><i class="ri-arrow-left-s-line" aria-hidden="true"></i> Edit my stack</button>
            <button type="button" class="cta bd-go" id="bdGo"><span id="bdGoText">Review stack</span> <i class="ri-arrow-right-line" id="bdGoIcon" aria-hidden="true"></i></button>
        </div>
    </aside>

    <footer class="footer">
        <div class="footer-container">
            <div class="footer-column"><h3><i class="ri-share-forward-box-line"></i> Ecosystem Hub</h3><ul>
                <li><a href="/">Home</a></li><li><a href="/websites">Websites</a></li><li><a href="/products">Products</a></li><li><a href="/pricing">Pricing</a></li><li><a href="/articles">Articles</a></li></ul></div>
            <div class="footer-column"><h3><i class="ri-rocket-2-line"></i> Flagship Product</h3><ul>
                <li><a href="/products/digital-business-card">Digital Business Card</a></li>
                <li><a href="/products/digital-business-card#demo">Live Demos</a></li>
                <li><a href="/products/digital-business-card#launch-package">Build Your Card</a></li>
                <li><a href="/payment" rel="nofollow">Payment <i class="ri-verified-badge-fill"></i></a></li></ul></div>
            <div class="footer-column"><h3><i class="ri-tools-line"></i> Technical Tools</h3><ul>
                {tools.map((t) => <li><a href={`/tools/${t.s}`}>{t.n}</a></li>)}</ul></div>
            <div class="footer-column"><h3><i class="ri-team-line"></i> Partnership</h3><ul>
                <li><a href="/partnership">Partnership Program</a></li><li><a href="/partnership/affiliate">Affiliate Portal</a></li><li><a href="/partnership/policy">Partner Policy</a></li></ul></div>
        </div>
        <div class="footer-bottom">
            <div class="footer-legal">
                <SocialLinks />
                <p>&copy; <span class="year"></span> Emmy STACK01. All Rights Reserved.</p>
            </div>
        </div>
    </footer>

    <script is:inline define:vars={{ price }}>
    (() => {
      const THANK_YOU = "/thank-you";            // ?type=card&stack=… is appended
      const BASE = ["Identity Core", "Smart Sharing"];
      const $ = (s, r = document) => r.querySelector(s), $$ = (s, r = document) => [...r.querySelectorAll(s)];
      const drawer = $("#bdDrawer"), overlay = $("#bdOverlay"), fab = $("#bdFab"), badge = $("#bdBadge");
      const go = $("#bdGo"), goText = $("#bdGoText"), goIcon = $("#bdGoIcon"), edit = $("#bdEdit"), tags = $("#bdTags"), body = $("#bdBody");
      const root = document.documentElement;
      let opener = null;

      const chosen = () => $$(".bd-chip[aria-pressed='true']").map((b) => b.dataset.name);

      function refresh() {
        const n = BASE.length + chosen().length;
        if (badge.textContent !== String(n)) {
          badge.textContent = n; badge.classList.remove("ping"); void badge.offsetWidth; badge.classList.add("ping");
        }
        fab.setAttribute("aria-label", `Open card builder, ${n} features selected`);
      }

      // Features toggle; integrations are one-per-group (tap again to clear).
      $$(".bd-chip[data-name]").forEach((chip) => chip.addEventListener("click", () => {
        const on = chip.getAttribute("aria-pressed") !== "true";
        if (chip.dataset.group) $$(".bd-chip", chip.parentElement).forEach((c) => setChip(c, false));
        setChip(chip, on);
        refresh();
      }));
      function setChip(chip, on) {
        chip.setAttribute("aria-pressed", String(on));
        const s = $(".state", chip); if (s) s.className = `${on ? "ri-check-line" : "ri-add-line"} state`;
      }

      function setStep(step) {
        drawer.dataset.step = step;
        const summary = step === "summary";
        goText.textContent = summary ? "Continue on WhatsApp" : "Review stack";
        goIcon.className = summary ? "ri-whatsapp-line" : "ri-arrow-right-line";
        fab.classList.toggle("ready", summary);
        if (summary) {
          tags.replaceChildren(...[...BASE, ...chosen()].map((t) => Object.assign(document.createElement("li"), { textContent: t })));
        }
        body.scrollTop = 0;
      }

      function open() {
        opener = document.activeElement;
        drawer.classList.add("open"); overlay.classList.add("open"); root.classList.add("bd-lock");
        fab.classList.remove("show");
        $("#bdClose").focus({ preventScroll: true });
      }
      function close() {
        drawer.classList.remove("open"); overlay.classList.remove("open"); root.classList.remove("bd-lock");
        syncFab();
        if (opener && opener.focus) opener.focus({ preventScroll: true });
      }
      const isOpen = () => drawer.classList.contains("open");

      $$("[data-open-builder]").forEach((b) => b.addEventListener("click", open));
      $("#bdClose").addEventListener("click", close);
      overlay.addEventListener("click", close);
      edit.addEventListener("click", () => setStep("select"));

      go.addEventListener("click", () => {
        if (drawer.dataset.step !== "summary") return setStep("summary");
        go.disabled = true; goText.textContent = "Connecting…";
        const stack = encodeURIComponent([...BASE, ...chosen()].join(", "));
        location.href = `${THANK_YOU}?type=card&stack=${stack}`;
      });
      // Coming back with the browser's Back button must not leave the button stuck on "Connecting…".
      addEventListener("pageshow", () => { go.disabled = false; if (drawer.dataset.step === "summary") setStep("summary"); });

      document.addEventListener("keydown", (e) => {
        if (!isOpen()) return;
        if (e.key === "Escape") return close();
        if (e.key !== "Tab") return;
        const f = $$("button:not([disabled]), a[href]", drawer).filter((el) => el.offsetParent !== null);
        if (!f.length) return;
        const first = f[0], last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      });

      // The floating button shows only while the package section is on screen.
      const section = $("#launch-package");
      let inView = !("IntersectionObserver" in window);
      function syncFab() { fab.classList.toggle("show", inView && !isOpen()); }
      if (!inView) new IntersectionObserver(([en]) => { inView = en.isIntersecting; syncFab(); }, { rootMargin: "-10% 0px -10% 0px" }).observe(section);
      syncFab();

      // Phone tilt (fine pointers only) — pure CSS variables, no layout work.
      const phone = $("#phone");
      if (matchMedia("(hover:hover) and (pointer:fine) and (min-width:1024px) and (prefers-reduced-motion:no-preference)").matches) {
        addEventListener("mousemove", (e) => {
          phone.style.setProperty("--ry", `${(e.clientX / innerWidth - .5) * 22}deg`);
          phone.style.setProperty("--rx", `${-(e.clientY / innerHeight - .5) * 22}deg`);
        }, { passive: true });
      }
      if (matchMedia("(prefers-reduced-motion:reduce)").matches) { const v = $("video", phone); if (v) { v.removeAttribute("autoplay"); v.pause(); } }

      // Entrance animations (GSAP optional: nothing is hidden in CSS, so the page works without it).
      addEventListener("DOMContentLoaded", () => {
        if (!window.gsap || !window.ScrollTrigger) return;
        gsap.registerPlugin(ScrollTrigger);
        gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", () => {
          gsap.from(".ch-copy > *", { y: 28, opacity: 0, duration: .9, ease: "power3.out", stagger: .12, clearProps: "all" });
          gsap.from(".ch-stage", { scale: .85, opacity: 0, duration: 1.1, ease: "power3.out", delay: .2, clearProps: "all" });
          gsap.utils.toArray(".reveal").forEach((el) => gsap.from(el, { scrollTrigger: { trigger: el, start: "top 90%" }, y: 50, opacity: 0, duration: 1, ease: "power3.out", clearProps: "all" }));
        });
      });
    })();
    </script>
    <script src="/script/card.js" defer></script>
    <script src="/script/year.js" defer></script>
</body>
</html>
