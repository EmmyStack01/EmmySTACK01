---
import Analytics from '@vercel/analytics/astro';
// Emmy STACK01 — partner / affiliate landing at /go?id=CODE (or ?partner=CODE).
// Shows the visitor's referral code, logs the click through /api/partner/click, then hands off to WhatsApp.
const phone = "2349076991076";
const discount = "5%";
---
<!DOCTYPE html>
<html lang="en">
<head>
    <script src="/script/meta-logic.js" is:inline></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Partner Referral | Emmy STACK01</title>
    <meta name="description" content="You were referred to Emmy STACK01 by a partner. Continue to WhatsApp to claim your referral discount.">
    <meta name="robots" content="noindex, nofollow">
    <meta name="theme-color" content="#0b1020">
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon_io/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon_io/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon_io/favicon-16x16.png">
    <link rel="manifest" href="/favicon_io/site.webmanifest">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Manrope:wght@400..800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.7.0/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="/style/index-style.css">
    <style>
        body { min-height: 100vh; min-height: 100dvh; background: var(--b-dark); color: var(--text-main); }
        .go {
            position: relative; isolation: isolate; overflow: hidden;
            display: grid; place-items: center; min-height: inherit;
            padding: clamp(2rem, 6vw, 4rem) var(--pad);
            text-align: center;
            background:
                radial-gradient(700px 420px at 85% 0%, color-mix(in srgb, var(--accent-color) 20%, transparent), transparent 70%),
                radial-gradient(640px 400px at 5% 100%, color-mix(in srgb, var(--primary-color) 32%, transparent), transparent 70%),
                var(--b-dark);
        }
        .go::before {
            content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
            background:
                linear-gradient(color-mix(in srgb, var(--primary-color) 18%, transparent) 1px, transparent 1px) 0 0 / 48px 48px,
                linear-gradient(90deg, color-mix(in srgb, var(--primary-color) 18%, transparent) 1px, transparent 1px) 0 0 / 48px 48px;
            -webkit-mask-image: radial-gradient(ellipse at center, #000 20%, transparent 75%);
            mask-image: radial-gradient(ellipse at center, #000 20%, transparent 75%);
        }
        .go-inner { display: grid; justify-items: center; width: 100%; max-width: 34rem; }
        .go .logo { color: var(--text-main); font-size: clamp(1.4rem, 1.2rem + 1vw, 1.8rem); }
        .go h1 {
            margin-top: clamp(1.5rem, 5vw, 2.5rem);
            font-family: var(--font-display); font-weight: 700; line-height: 1; text-transform: uppercase; letter-spacing: -.01em;
            font-size: clamp(2.2rem, 1.4rem + 3.6vw, 3.8rem); text-wrap: balance;
        }
        .go .sub { margin-top: .9rem; max-width: 36ch; color: var(--text-muted); font-size: clamp(1rem, .94rem + .3vw, 1.15rem); text-wrap: pretty; }
        .code-box {
            width: 100%; max-width: 22rem; margin-top: clamp(1.5rem, 5vw, 2.25rem); padding: 1.1rem 1rem 1.25rem;
            border: 1px solid color-mix(in srgb, var(--accent-color) 35%, transparent); border-radius: 22px;
            background: color-mix(in srgb, var(--text-main) 6%, transparent);
        }
        .code-label { font-size: var(--fs-small); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--text-muted); }
        .code {
            margin-top: .35rem; font-family: var(--font-display); font-weight: 800; line-height: 1; letter-spacing: .04em;
            font-size: clamp(2.2rem, 1.6rem + 3vw, 3.2rem); overflow-wrap: anywhere;
            background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent;
        }
        .perk { display: inline-flex; align-items: center; gap: .4rem; margin-top: .8rem; padding: .3rem .85rem; border-radius: 999px; background: color-mix(in srgb, var(--accent-color) 16%, transparent); font-size: var(--fs-small); font-weight: 700; color: var(--accent-color); }
        .go .cta { margin-top: clamp(1.5rem, 4vw, 2rem); }
        .go .back { display: inline-flex; align-items: center; min-height: 44px; margin-top: .75rem; font-size: var(--fs-small); font-weight: 700; color: var(--accent-color); text-decoration: underline; text-underline-offset: 3px; }
        .go .error-title { color: #ff6b6b; }
        .go [hidden] { display: none !important; }
        .go :focus-visible { outline-color: var(--accent-color); }
    </style>
    <Analytics />
</head>
<body>
    <main class="go">
        <div class="go-inner">
            <a class="logo" href="/" aria-label="Emmy STACK01 home">Emmy STACK01</a>

            <h1 id="title">Loading your referral…</h1>
            <p class="sub" id="subtitle">One moment.</p>

            <div class="code-box" id="badge" hidden>
                <p class="code-label">Your referral code</p>
                <p class="code" id="code"></p>
                <span class="perk"><i class="ri-price-tag-3-line" aria-hidden="true"></i> {discount} off your project</span>
            </div>

            <a href="#" id="wa-btn" class="cta" hidden><i class="ri-whatsapp-line" aria-hidden="true"></i> Continue to WhatsApp</a>
            <a href="/" class="back" id="home-link" hidden>Go to the homepage</a>

            <noscript><p class="sub">Please enable JavaScript to use this referral link, or message us directly at <a class="back" href={`https://wa.me/${phone}`}>WhatsApp</a>.</p></noscript>
        </div>
    </main>

    <script is:inline define:vars={{ phone, discount }}>
        const $ = (id) => document.getElementById(id);
        const params = new URLSearchParams(location.search);
        // Accept ?id= or ?partner=. Keep only letters, digits, dash and underscore so nothing odd can reach the page, the sheet or the chat message.
        const code = (params.get("id") || params.get("partner") || "").toUpperCase().replace(/[^A-Z0-9_-]/g, "").slice(0, 32);

        if (code) {
            $("title").textContent = "You’ve been referred!";
            $("subtitle").textContent = "Tap the button below to message us on WhatsApp — your partner’s code is already included.";
            $("code").textContent = code;
            $("badge").hidden = false;

            const text = `Hey Emmy, I need a website. I was referred for ${discount} off. Code: ${code}`;
            const btn = $("wa-btn");
            btn.href = `https://wa.me/${phone}?text=${encodeURIComponent(text)}`;
            btn.hidden = false;

            // Count the click in the background. The server de-duplicates per visitor per day and ignores bots.
            fetch("/api/partner/click", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ code }), keepalive: true }).catch(() => {});
        } else {
            $("title").textContent = "Link not valid";
            $("title").classList.add("error-title");
            $("subtitle").textContent = "This referral link is missing its partner code. Please check the link you were given.";
            $("home-link").hidden = false;
        }
    </script>
</body>
</html>
