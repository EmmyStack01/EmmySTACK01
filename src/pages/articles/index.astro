---
export const prerender = true;
import SocialLinks from "../../components/SocialLinks.astro";
// src/pages/articles/index.astro — the articles list (/articles). Styles: /style/index-style.css + /style/articles-style.css
import { keystaticReader } from '../../reader';

const site = "https://emmystack01.com";
const url = `${site}/articles`;
const title = "Digital Marketing, SEO & Website Insights | Emmy STACK01";
const desc = "Explore Emmy STACK01 articles on SEO, websites, digital identity, branding and growing your online presence.";
const ogImage = `${site}/asset/og-image4.jpg`;
const tools = [
  { n: "Website Auditor", s: "website-auditor", i: "ri-shield-check-line" },
  { n: "Social Architect", s: "social-architect", i: "ri-node-tree" },
  { n: "Meeting Studio", s: "meeting_background_studio", i: "ri-vidicon-line" },
  { n: "PDF Signer", s: "emmy-sign", i: "ri-file-pdf-2-line" },
  { n: "Invoice Generator", s: "naira-wise", i: "ri-bill-line" },
];

// Dates are stored as YYYY-MM-DD; format them the same on the server and in every article.
const fmt = (d?: string) => d ? new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }).format(new Date(d)) : "";
const time = (d?: string) => (d ? new Date(d).getTime() : 0) || 0;

// 1. Read every entry from the Keystatic collection, newest first
const raw = await keystaticReader.collections.articles.all();
const articles = raw
  .map((a) => ({
    slug: a.slug,
    title: a.entry.title,
    description: a.entry.description,
    date: a.entry.date,
    readingTime: a.entry.readingTime,
    category: a.entry.category,
    image: a.entry.coverImage,
  }))
  .sort((a, b) => time(b.date) - time(a.date));

// 2. The newest article is featured; the rest fill the grid
const [featured, ...others] = articles;

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "The Digital DNA Log | Emmy STACK01 Articles",
  description: "Explore insights on digital identity, SEO personal portfolios, and the future of networking in 2026.",
  url,
  isPartOf: { "@type": "WebSite", "@id": `${site}/#website`, name: "Emmy STACK01", url: site },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: articles.length,
    itemListElement: articles.map((a, i) => ({ "@type": "ListItem", position: i + 1, url: `${site}/articles/${a.slug}`, name: a.title })),
  },
};
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="/script/meta-logic.js" is:inline></script>
    <meta name="robots" content="index, follow">
    <meta name="author" content="Emmy STACK01">
    <meta name="theme-color" content="#0b1020">

    <link rel="stylesheet" href="/style/index-style.css">
    <link rel="stylesheet" href="/style/articles-style.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Manrope:wght@400..800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.7.0/fonts/remixicon.css" rel="stylesheet">

    <link rel="apple-touch-icon" sizes="180x180" href={`${site}/favicon_io/apple-touch-icon.png`}>
    <link rel="icon" type="image/png" sizes="32x32" href={`${site}/favicon_io/favicon-32x32.png`}>
    <link rel="icon" type="image/png" sizes="16x16" href={`${site}/favicon_io/favicon-16x16.png`}>
    <link rel="manifest" href={`${site}/favicon_io/site.webmanifest`}>
    <title>{title}</title>
    <meta name="description" content={desc}>
    <link rel="canonical" href={url}>

    <meta property="og:site_name" content="Emmy STACK01">
    <meta property="og:type" content="website">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={desc}>
    <meta property="og:url" content={url}>
    <meta property="og:image" content={ogImage}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@Emmy_STACK01">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={desc}>
    <meta name="twitter:image" content={ogImage}>

    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
</head>
<body>
    <!-- Desktop nav -->
    <nav class="nav" aria-label="Main">
        <a class="logo" href="/">Emmy STACK01</a>
        <ul class="nav-links">
            <li><a href="/">Home</a></li>
            <li><a href="/websites">Websites</a></li>
            <li><a href="/products">Product</a></li>
            <li class="dropdown js-dropdown">
                <button type="button" class="dropbtn" aria-expanded="false">Tools <i class="ri-arrow-down-s-line"></i></button>
                <div class="dropdown-content">
                    {tools.map((t) => <a href={`/tools/${t.s}`}><i class={t.i}></i> {t.n}</a>)}
                </div>
            </li>
            <li><a href="/partnership">Partnership Program <span class="earn-pill">EARN</span> </a></li>
            <li><a href="/articles" aria-current="page">Articles</a></li>
        </ul>
        <a href="/articles#newsletter" class="cta nav-cta">Join the Insider Log <i class="ri-arrow-right-line"></i></a>
    </nav>

    <!-- Mobile bar -->
    <div class="navbar">
        <a class="logo" href="/">Emmy STACK01</a>
        <button class="nav-toggle" id="openMenu" aria-label="Open navigation" aria-controls="drawer" aria-expanded="false">
            <span class="line"></span><span class="line"></span><span class="line"></span>
        </button>
    </div>

    <div class="overlay" id="overlay"></div>
    <aside class="drawer" id="drawer" aria-label="Site navigation" aria-hidden="true">
        <div class="drawer-header">
            <a class="logo" href="/">Emmy STACK01</a>
            <button id="closeMenu" class="close-btn" aria-label="Close navigation"><i class="ri-close-line"></i></button>
        </div>
        <nav class="drawer-nav">
            <a href="/" class="drawer-link"><i class="ri-home-line"></i> Home</a>
            <a href="/websites" class="drawer-link"><i class="ri-layout-4-line"></i> Websites</a>
            <a href="/products" class="drawer-link"><i class="ri-box-3-line"></i> Product</a>
            <button class="drawer-link dropdown-btn" id="toolsBtn" aria-expanded="false" aria-controls="toolsMenu">
                <i class="ri-tools-line"></i> Tools <i class="ri-arrow-down-s-line chev"></i>
            </button>
            <div class="submenu" id="toolsMenu"><div class="submenu-inner">
                {tools.map((t) => <a href={`/tools/${t.s}`}><i class={t.i}></i> {t.n}</a>)}
            </div></div>
            <a href="/partnership" class="drawer-link"><i class="ri-team-line"></i> Partnership Program <span class="earn-pill">EARN</span></a>
            <a href="/articles" class="drawer-link active" aria-current="page"><i class="ri-article-line"></i> Articles</a>
        </nav>
        <a href="/articles#newsletter" class="cta project-btn">Join the Insider Log <i class="ri-arrow-right-line"></i></a>
        <div class="drawer-foot">
            <SocialLinks />
            <p>&copy; <span class="year"></span> Emmy STACK01. All rights reserved.</p>
        </div>
    </aside>

    <header class="ar-hero list">
        <div class="ar-hero-inner">
            <span class="ar-eyebrow">The Digital DNA Log</span>
            <h1>Digital growth insights</h1>
            <p>Practical insights on SEO, websites, digital identity, branding and online growth.</p>
        </div>
    </header>

    <main>
        <div class="ar-section">
            {featured ? (
                <article class="ar-featured" aria-label="Featured article">
                    <div class="ar-thumb">
                        {featured.image
                            ? <img src={featured.image} alt={featured.title} width="1200" height="750" fetchpriority="high" decoding="async">
                            : <div class="ar-ph" aria-hidden="true"><i class="ri-image-line"></i></div>}
                        <span class="ar-flag">Featured</span>
                    </div>
                    <div class="ar-featured-body">
                        <div class="ar-card-meta">
                            {featured.category && <span>{featured.category}</span>}
                            {featured.category && <span aria-hidden="true">•</span>}
                            <time datetime={featured.date}>{fmt(featured.date)}</time>
                            {featured.readingTime && <span aria-hidden="true">•</span>}
                            {featured.readingTime && <span>{featured.readingTime}</span>}
                        </div>
                        <h2><a href={`/articles/${featured.slug}`}>{featured.title}</a></h2>
                        <p class="desc">{featured.description}</p>
                        <a href={`/articles/${featured.slug}`} class="btn-white">Read the article <i class="ri-arrow-right-line" aria-hidden="true"></i></a>
                    </div>
                </article>
            ) : (
                <div class="ar-empty">
                    <i class="ri-article-line" aria-hidden="true"></i>
                    <h2>No articles yet</h2>
                    <p>New insights are on the way. Join the Insider Log below to hear when they land.</p>
                </div>
            )}
        </div>

        {others.length > 0 && (
            <section class="ar-section" style="padding-top:0" aria-labelledby="latest">
                <h2 class="ar-section-title" id="latest">Latest entries</h2>
                <div class="ar-grid">
                    {others.map((a) => (
                        <article class="ar-card">
                            <div class="ar-thumb">
                                {a.image
                                    ? <img src={a.image} alt={a.title} width="800" height="500" loading="lazy" decoding="async">
                                    : <div class="ar-ph" aria-hidden="true"><i class="ri-image-line"></i></div>}
                                {a.category && <span class="ar-badge">{a.category}</span>}
                            </div>
                            <div class="ar-card-body">
                                <div class="ar-card-meta">
                                    <time datetime={a.date}>{fmt(a.date)}</time>
                                    {a.readingTime && <span aria-hidden="true">•</span>}
                                    {a.readingTime && <span>{a.readingTime}</span>}
                                </div>
                                <h3><a href={`/articles/${a.slug}`}>{a.title}</a></h3>
                                <p>{a.description}</p>
                                <span class="ar-more" aria-hidden="true">Explore entry <i class="ri-arrow-right-up-line"></i></span>
                            </div>
                        </article>
                    ))}
                </div>
            </section>
        )}

        <div class="ar-section" style="padding-top:0">
            <section class="ar-news" id="newsletter" aria-labelledby="news-title">
                <span class="ar-eyebrow">The Emmy STACK01 Insider Log</span>
                <h2 id="news-title">Stay ahead of the ecosystem</h2>
                <p>Get early access to premium product releases, exclusive discount deals, hidden technical tips, and open tracking opportunities in our 16.67% Partnership Program.</p>
                <form action="https://app.kit.com/forms/9527987/subscriptions" method="post" class="ar-form">
                    <label for="email" class="sr-only">Email address</label>
                    <input type="email" id="email" name="email_address" required autocomplete="email" placeholder="Enter your professional email…">
                    <button type="submit" class="cta">Subscribe</button>
                </form>
            </section>
        </div>
    </main>

    <!-- Shown after the Kit form redirects back with ?status=success or ?status=confirmed -->
    <div id="successModal" class="modal-overlay" aria-hidden="true">
        <div class="modal-content" role="dialog" aria-modal="true" aria-labelledby="modalTitle" aria-describedby="modalDescription">
            <button type="button" class="modal-close" id="closeSuccess" aria-label="Close"><i class="ri-close-line"></i></button>
            <p class="ar-eyebrow" id="modalSubtitle" style="color:var(--primary-color)">Transmission successful</p>
            <h3 class="modal-title" id="modalTitle">Access initiated</h3>
            <p class="modal-text" id="modalDescription" style="margin-bottom:0">You're almost in. We just sent a verification link to your inbox. Check your email to confirm your subscription and unlock the STACK01 Ecosystem.</p>
        </div>
    </div>

    <footer class="footer">
        <div class="footer-container">
            <div class="footer-column"><h3><i class="ri-share-forward-box-line"></i> Ecosystem Hub</h3><ul>
                <li><a href="/">Home</a></li><li><a href="/websites">Websites</a></li><li><a href="/products">Products</a></li><li><a href="/pricing">Pricing</a></li><li><a href="/articles">Articles</a></li></ul></div>
            <div class="footer-column"><h3><i class="ri-rocket-2-line"></i> Flagship Product</h3><ul>
                <li><a href="/products/digital-business-card">Digital Business Card</a></li>
                <li><a href="/products/digital-business-card#demo">Live Demos</a></li>
                <li><a href="/products/digital-business-card#launch-package">Build Your Card</a></li>
                <li><a href="/payment" rel="nofollow">Payment <i class="ri-verified-badge-fill"></i></a></li></ul></div>
            <div class="footer-column"><h3><i class="ri-tools-line"></i> Technical Tools</h3><ul>
                {tools.map((t) => <li><a href={`/tools/${t.s}`}>{t.n}</a></li>)}</ul></div>
            <div class="footer-column"><h3><i class="ri-team-line"></i> Partnership</h3><ul>
                <li><a href="/partnership">Partnership Program</a></li><li><a href="/partnership/affiliate">Affiliate Portal</a></li><li><a href="/partnership/policy">Partner Policy</a></li></ul></div>
        </div>
        <div class="footer-bottom">
            <div class="footer-legal">
                <SocialLinks />
                <p>&copy; <span class="year"></span> Emmy STACK01. All Rights Reserved.</p>
            </div>
        </div>
    </footer>

<script is:inline>
document.addEventListener("DOMContentLoaded", () => {
  const $ = (s, r = document) => r.querySelector(s), $$ = (s, r = document) => [...r.querySelectorAll(s)];

  // Drawer
  const drawer = $("#drawer"), overlay = $("#overlay"), openBtn = $("#openMenu");
  const setDrawer = (open) => {
    drawer.classList.toggle("open", open); overlay.classList.toggle("open", open);
    drawer.setAttribute("aria-hidden", String(!open)); openBtn.setAttribute("aria-expanded", String(open));
    document.body.classList.toggle("no-scroll", open);
    if (open) $("#closeMenu").focus(); else openBtn.focus({ preventScroll: true });
  };
  openBtn.addEventListener("click", () => setDrawer(true));
  $("#closeMenu").addEventListener("click", () => setDrawer(false));
  overlay.addEventListener("click", () => setDrawer(false));
  $$("#drawer a").forEach((a) => a.addEventListener("click", () => setDrawer(false)));
  const toolsBtn = $("#toolsBtn");
  toolsBtn.addEventListener("click", () => {
    const o = $("#toolsMenu").classList.toggle("open");
    toolsBtn.classList.toggle("open", o); toolsBtn.setAttribute("aria-expanded", String(o));
  });

  // Desktop dropdown (click for touch, hover/focus via CSS)
  const dd = $(".js-dropdown"), ddBtn = $(".dropbtn", dd);
  ddBtn.addEventListener("click", (e) => { e.stopPropagation(); ddBtn.setAttribute("aria-expanded", String(dd.classList.toggle("open"))); });
  document.addEventListener("click", () => { dd.classList.remove("open"); ddBtn.setAttribute("aria-expanded", "false"); });

  // Subscription result modal (Kit redirects back with ?status=success or ?status=confirmed)
  const modal = $("#successModal"), closeBtn = $("#closeSuccess");
  let lastFocus;
  const showModal = (open) => {
    modal.classList.toggle("is-active", open); modal.setAttribute("aria-hidden", String(!open));
    if (open) { lastFocus = document.activeElement; closeBtn.focus(); } else if (lastFocus) lastFocus.focus({ preventScroll: true });
  };
  closeBtn.addEventListener("click", () => showModal(false));
  modal.addEventListener("click", (e) => { if (e.target === modal) showModal(false); });
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    if (modal.classList.contains("is-active")) showModal(false);
    else if (drawer.classList.contains("open")) setDrawer(false);
  });

  const status = new URLSearchParams(location.search).get("status");
  if (status === "success" || status === "confirmed") {
    if (status === "confirmed") {
      $("#modalSubtitle").textContent = "Verification complete";
      $("#modalTitle").textContent = "Integration complete";
      $("#modalDescription").innerHTML = "Welcome to the <strong>STACK01 Ecosystem</strong>. Your insider access is officially active. Prepare for upcoming premium drops, hidden technical documentation, and tracking updates sent straight to your inbox.";
    }
    showModal(true);
    history.replaceState(null, "", location.pathname + location.hash); // tidy the URL
  }
});
</script>
<script src="/script/year.js" defer></script>
</body>
</html>
