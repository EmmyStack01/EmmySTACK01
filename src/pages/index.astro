            <SocialLinks />
            <p>&copy; <span class="year"></span> Emmy STACK01. All rights reserved.</p>
        </div>
    </aside>

    <header class="hero">
        <div class="hero-inner">
            <div class="hero-copy">
                <h1 class="hero-title"><span class="t1">Build your</span><span class="t2">website</span><span class="t3">from scratch to the internet.</span></h1>
                <p class="hero-sub">High-performance websites for businesses, personal brands, creators and professionals in Nigeria.</p>
            </div>
            <div class="hero-art">
                <div class="art-stage">
                    <div class="art-card">
                        <img src="/asset/hero-card.svg" alt="" width="1316" height="1049" aria-hidden="true">
