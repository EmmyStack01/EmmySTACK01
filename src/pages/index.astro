---
export const prerender = true;
import SocialLinks from '../components/SocialLinks.astro';

const site = "https://emmystack01.com";
const title = "Web Design & Development Agency in Nigeria | Emmy STACK01";
const desc = "Emmy STACK01 builds high-performance websites for businesses, personal brands, creators and professionals in Nigeria, with UI/UX design, branding and on-page SEO.";
const ogDesc = "A one-stop digital agency specializing in Brand Identity, UI/UX design, and high-performance web development.";

const tools = [
  { n: "Website Auditor", s: "website-auditor", i: "ri-shield-check-line", c: "DeveloperApplication", d: "A technical optimization utility designed to scan and audit website performance, structural health, and SEO setups." },
  { n: "Social Architect", s: "social-architect", i: "ri-node-tree", c: "BusinessApplication", d: "A mobile hook formatter designed for structuring and optimizing content streams on LinkedIn and X." },
  { n: "Meeting Studio", s: "meeting_background_studio", i: "ri-vidicon-line", c: "MultimediaApplication", d: "A custom layout studio providing professional virtual assets and interface environments for live video calls." },
  { n: "PDF Signer", s: "emmy-sign", i: "ri-file-pdf-2-line", c: "BusinessApplication", d: "A secure, zero-bloat browser utility engineered for signing documents and processing PDFs directly on the web." },
  { n: "Invoice Generator", s: "naira-wise", i: "ri-bill-line", c: "BusinessApplication", d: "A clean, functional utility designed for digital service providers to generate professional business invoices seamlessly." },
];

const tiles = [
  { i: "ri-id-card-line", id: "digital-business-card", t: "Digital Business Card Website", f: "Entrepreneurs, Professionals & Creators", d: "A professional digital card with one-tap contact sharing.", v: "card" },
  { i: "ri-palette-line", id: "creator-portfolio-websites", t: "Creator & Portfolio Websites", f: "Photographers, Musicians & Creators", d: "Portfolio websites built to showcase your work and brand.", v: "port" },
  { i: "ri-article-line", id: "resume-personal-websites", t: "Resume & Personal Websites", f: "Job Seekers & Tech Professionals", d: "Personal websites for your CV, experience and work.", v: "resume" },
  { i: "ri-edit-line", id: "blog-content-websites", t: "Blog & Content Websites", f: "Writers, Influencers & Publishers", d: "Fast-loading blog websites for content and audience growth.", v: "blog" },
  { i: "ri-briefcase-line", id: "business-service-websites", t: "Business & Service Websites", f: "Law Firms, Clinics, Shops & Service Businesses", d: "Business websites built for enquiries, bookings and customers.", v: "biz" },
  { i: "ri-home-4-line", id: "real-estate-websites", t: "Real Estate Websites", f: "Real Estate Agents & Developers", d: "Property websites with listings, galleries and a premium feel.", v: "estate" },
  { i: "ri-command-line", id: "startup-saas-websites", t: "Startup & SaaS Websites", f: "Startups, Agencies & Product Teams", d: "Fast websites and tools built for digital products.", v: "saas" },
  { i: "ri-rocket-line", id: "landing-pages-brochures", t: "Landing Pages & Digital Brochures", f: "Product Launches, Apps & Campaigns", d: "High-speed landing pages for products, services and offers.", v: "land" },
];

// Decorative mini-website visuals for the stacked cards (CSS-drawn, hidden from screen readers)
const L = (w, c = "") => `<i class="mk-line ${c}" style="--w:${w}"></i>`;
const visuals = {
  card: `<div class="mk mk-card"><span class="mk-cover g2"></span><span class="mk-avatar g1"></span>${L(44, "strong")}${L(30)}<span class="mk-row"><b class="mk-btn">Save contact</b><b class="mk-btn ghost">WhatsApp</b></span><span class="mk-icons"><i></i><i></i><i></i><i></i></span></div>`,
  port: `<div class="mk mk-port"><span class="mk-nav">${L(20, "strong")}<em></em><em></em><em></em></span><span class="mk-mosaic"><i class="g2 a"></i><i class="g1 b"></i><i class="g3 c"></i><i class="g4 d"></i><i class="g5 e"></i></span></div>`,
  resume: `<div class="mk mk-resume"><span class="mk-side"><span class="mk-avatar g1"></span>${L(72, "strong")}${L(52)}<span class="mk-chips"><i></i><i></i><i></i></span></span><span class="mk-main">${L(42, "strong")}${L(96)}${L(82)}${L(42, "strong")}${L(92)}${L(70)}${L(86)}</span></div>`,
  blog: `<div class="mk mk-blog"><span class="mk-feature g2"></span>${L(72, "strong")}${L(96)}<span class="mk-list"><span class="mk-item"><i class="g1"></i><span>${L(84)}${L(52)}</span></span><span class="mk-item"><i class="g3"></i><span>${L(74)}${L(60)}</span></span></span></div>`,
  biz: `<div class="mk mk-biz"><span class="mk-hero"><span class="mk-hero-text">${L(86, "strong")}${L(62, "strong")}${L(94)}<b class="mk-btn">Book now</b></span><span class="mk-hero-img g2"></span></span><span class="mk-tiles"><i></i><i></i><i></i></span></div>`,
  estate: `<div class="mk mk-estate"><span class="mk-prop"><i class="g2"><b>For sale</b></i>${L(76, "strong")}${L(46)}</span><span class="mk-prop"><i class="g1"><b>4 bed</b></i>${L(66, "strong")}${L(56)}</span><span class="mk-prop"><i class="g3"><b>New</b></i>${L(80, "strong")}${L(40)}</span></div>`,
  saas: `<div class="mk mk-saas"><span class="mk-hero2">${L(62, "strong")}${L(88)}<b class="mk-btn">Start free</b></span><span class="mk-dash"><span class="mk-chart"><i style="--h:40"></i><i style="--h:62"></i><i style="--h:48"></i><i style="--h:80"></i><i style="--h:68"></i><i style="--h:94"></i></span><span class="mk-stats"><i class="g1"></i><i class="g5"></i></span></span></div>`,
  land: `<div class="mk mk-land"><span class="mk-badge">New launch</span>${L(74, "strong")}${L(52, "strong")}<b class="mk-btn">Get the app</b><span class="mk-product"><i class="g2"></i><i class="g1"></i><i class="g3"></i></span></div>`,
};

const steps = [
  { t: "Choose Your Website", d: "Select the website type for your industry and goal." },
  { t: "Strategy Sync", d: "A quick chat to align your website, goals and brand." },
  { t: "Rapid Launch", d: "Your custom-coded site goes live within 14 days." },
];

const ticker = ["High-performance websites", "Digital identities", "SEO", "Performance", "Conversion"];

const faqs = [
  { q: "What is Emmy STACK01?", a: "Emmy STACK01 is a web design and development agency that builds high-performance websites for businesses, personal brands, creators and professionals. We also handle UI/UX design, branding, on-page SEO, hosting setup and Google indexing." },
  { q: "Why does Emmy STACK01 charge per page?", a: "We use a per-page pricing model to ensure total cost transparency. Whether you need a high-converting one-page landing site or a multi-page corporate website, you’ll know the exact investment required before we begin. This eliminates hidden fees and allows us to scale our website design and development services to fit your specific budget." },
  { q: "Are the technical services like hosting and Google indexing really free?", a: "Yes! While other agencies charge monthly maintenance fees, we provide free website hosting via GitHub Pages and complimentary Google search indexing. We also handle your domain name configuration and SSL setup at no extra cost. Our goal is to lower the barrier to entry for your digital presence, saving you significant annual costs on traditional hosting providers." },
  { q: "Why is there a “Built by Emmy STACK01” tag on my site?", a: "We take immense pride in every project we launch. This tag serves as a seal of quality, letting your visitors know your site was built to professional standards. It also allows other businesses to easily find the same high-performance web development and design services that we provided for you." },
  {
    q: "How does Emmy STACK01 handle website updates after the launch?",
    a: "We offer three flexible ways to keep your digital presence updated:",
    list: [
      ["Minor Updates (“The Quick Tweak”)", "Best for text changes, image swaps, or small styling tweaks to existing sections. These are billed as a flat fee per request."],
      ["Major Updates (“The Evolution”)", "For new pages, structural layout changes, or added functionality (like a newsletter or dark mode). These are treated as new project modules and quoted separately."],
      ["CMS Integration (“The Control”)", "We can integrate a custom Content Management System (CMS) that allows you to edit your own content (blogs, portfolio, prices) in real-time without writing a single line of code. This is a one-time setup fee."],
    ],
    after: "For clients who want hands-off peace of mind, we also offer a Monthly Growth Retainer which includes priority support, security audits, and regular maintenance.",
  },
];
const plain = (f) => [f.a, ...(f.list || []).map(([h, t], i) => `${i + 1}. ${h}: ${t}`), f.after || ""].join(" ").trim();

const org = `${site}/#organization`;
const schema = [
  {
    "@context": "https://schema.org", "@type": "Organization", "@id": org, name: "Emmy STACK01", url: `${site}/`,
    logo: { "@type": "ImageObject", url: `${site}/asset/emmy-stack01-logo.png` },
    description: "Emmy STACK01 is a web design and development agency building high-performance websites for businesses, personal brands, creators and professionals, with branding, UI/UX design and on-page SEO.",
    sameAs: ["https://x.com/Emmy_STACK01", "https://github.com/EmmyStack01", "https://wa.me/2349076991076", "https://www.trustpilot.com/review/emmystack01.com", "https://themanifest.com/company/emmy-stack01"],
    hasOfferCatalog: {
      "@type": "OfferCatalog", name: "The STACK01 Build Menu",
      itemListElement: tiles.map((t) => ({ "@type": "Offer", itemOffered: { "@type": "Service", name: t.t, description: `${t.d} For ${t.f}.` } })),
    },
  },
  ...tools.map((t) => ({
    "@context": "https://schema.org", "@type": "WebApplication", "@id": `${site}/tools/${t.s}/#webapp`, name: t.n,
    url: `${site}/tools/${t.s}`, applicationCategory: t.c, operatingSystem: "All",
    browserRequirements: "Requires HTML5 compatible browser.", description: t.d, creator: { "@id": org },
  })),
  {
    "@context": "https://schema.org", "@type": "FAQPage", about: { "@id": org },
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: plain(f) } })),
  },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
