    <meta property="og:image:alt" content="Emmy STACK01 Banner">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@Emmy_STACK01">
    <meta name="twitter:title" content="Emmy STACK01 | Digital Agency">
    <meta name="twitter:description" content={ogDesc}>
    <meta name="twitter:image" content={`${site}/asset/og-home.png`}>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" defer></script>
