    </div>

    <main>
        <section class="solutions" id="solutions">
            <div class="section">
                <div class="solutions-head">
                    <h2 class="sec-title">Website solutions for brands</h2>
                    <p class="solutions-intro">Pick the website that fits your goal. Every site is custom-coded and goes live within 14 days.</p>
                </div>
                <div class="stack">
                    {tiles.map((t, i) => (
                        <article class="stack-card" style={`--i:${i}`}>
                            <div class="stack-copy">
                                <span class="tile-icon"><i class={t.i} aria-hidden="true"></i></span>
                                <h3>{t.t}</h3>
                                <p class="stack-for"><strong>For:</strong> {t.f}</p>
                                <p class="stack-desc">{t.d}</p>
                                <a class="cta stack-link" href={`/websites#${t.id}`}>Explore this solution <i class="ri-arrow-right-line" aria-hidden="true"></i></a>
                            </div>
                            <div class="visual" aria-hidden="true">
                                <div class="browser">
                                    <div class="bar"><i></i><i></i><i></i><b></b></div>
                                    <Fragment set:html={visuals[t.v]} />
                                </div>
                            </div>
                        </article>
                    ))}
